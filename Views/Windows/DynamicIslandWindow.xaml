<Window x:Class="OpenTaskbar.Views.Windows.DynamicIslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:widgets="clr-namespace:OpenTaskbar.Views.Widgets"
        Width="344" Height="50" MinWidth="264" MaxWidth="440" MinHeight="50" MaxHeight="246"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" AllowsTransparency="True" Background="Transparent" Focusable="False"
        Foreground="{DynamicResource TextPrimary}" FontFamily="{DynamicResource InterfaceFont}"
        FontSize="{DynamicResource TextSizeBody}"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewMouseWheel="Window_PreviewMouseWheel"
        Closed="Window_Closed">
    <Window.Resources>
        <Style x:Key="IslandButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceSelected}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource WidgetQuickActionRadius}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SurfacePressed}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="IslandRoot" ClipToBounds="False">
        <Path Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top"
              Data="M0,0 L12,0 L12,12 A12,12 0 0 0 0,0 Z">
            <Path.Style>
                <Style TargetType="Path">
                    <Setter Property="Fill" Value="{DynamicResource DynamicIslandMaterial}" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Fill" Value="{DynamicResource SurfaceHover}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Path.Style>
        </Path>
        <Path Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top"
              Data="M0,0 L12,0 L12,12 A12,12 0 0 0 0,0 Z"
              RenderTransformOrigin="0.5,0.5">
            <Path.Style>
                <Style TargetType="Path">
                    <Setter Property="Fill" Value="{DynamicResource DynamicIslandMaterial}" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Fill" Value="{DynamicResource SurfaceHover}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Path.Style>
            <Path.RenderTransform><ScaleTransform ScaleX="-1" /></Path.RenderTransform>
        </Path>
        <Border x:Name="IslandSurface" Width="320" HorizontalAlignment="Center"
                Background="{DynamicResource DynamicIslandMaterial}" BorderThickness="0"
                CornerRadius="0,0,17,17" ClipToBounds="True">
            <Grid x:Name="IslandContent" ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid x:Name="Header" Grid.Row="0" Cursor="Arrow" Focusable="True"
                      PreviewMouseLeftButtonDown="Header_PreviewMouseLeftButtonDown"
                      PreviewMouseMove="Header_PreviewMouseMove"
                      PreviewMouseLeftButtonUp="Header_PreviewMouseLeftButtonUp"
                      PreviewKeyDown="Header_PreviewKeyDown"
                      GotKeyboardFocus="Header_GotKeyboardFocus"
                      LostKeyboardFocus="Header_LostKeyboardFocus">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Border x:Name="PageViewport" Margin="8,6,8,2" MouseLeftButtonUp="PageViewport_MouseLeftButtonUp"
                            ClipToBounds="True" Background="Transparent">
                        <widgets:DynamicIslandPagePanel x:Name="Pages" />
                    </Border>
                    <Border x:Name="HeaderFocusRing" Margin="1" BorderBrush="{DynamicResource StrokeFocus}"
                            BorderThickness="1" CornerRadius="0,0,17,17" Opacity="0"
                            IsHitTestVisible="False" />
                </Grid>
                <Border x:Name="DetailsPanel" Grid.Row="1" Padding="8,6,8,8"
                        PreviewMouseLeftButtonDown="Details_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="Details_PreviewMouseMove"
                        PreviewMouseLeftButtonUp="Details_PreviewMouseLeftButtonUp"
                        Visibility="Collapsed" Background="Transparent">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollViewer x:Name="DetailsScrollViewer" Grid.Row="0"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="False">
                            <ContentControl x:Name="DetailsContent" HorizontalContentAlignment="Stretch"
                                            Foreground="{DynamicResource TextPrimary}" />
                        </ScrollViewer>
                        <StackPanel x:Name="PageNavigation" Grid.Row="1" Orientation="Horizontal"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,0"
                                    Visibility="Collapsed">
                            <StackPanel x:Name="PageIndicators" Orientation="Horizontal"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        IsHitTestVisible="False" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
