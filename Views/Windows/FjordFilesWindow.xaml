<Window x:Class="OpenTaskbar.FjordFilesWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:OpenTaskbar.Services"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="{local:FjordLoc Title}" Width="1070" Height="660" MinWidth="710" MinHeight="420"
 WindowStyle="None" WindowStartupLocation="CenterScreen" Background="#101B2C"
 Foreground="#EDF4FC" FontFamily="Segoe UI" UseLayoutRounding="True" PreviewKeyDown="WindowKeyDown"
 AutomationProperties.Name="{local:FjordLoc Title}">
 <shell:WindowChrome.WindowChrome>
  <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
 </shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Foreground" Value="#DDECFB"/>
   <Setter Property="Padding" Value="10,6"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="Button">
     <Border x:Name="Surface" CornerRadius="7" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#304764"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="Background" Value="#304764"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="#142237"/>
   <Setter Property="Foreground" Value="#EAF3FC"/>
   <Setter Property="CaretBrush" Value="White"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="10,5"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Geometry x:Key="FolderShape">M 1,4 L 1,2 L 6,2 L 8,4 L 16,4 L 16,13 L 1,13 Z</Geometry>
  <Geometry x:Key="FileShape">M 3,1 L 11,1 L 15,5 L 15,14 L 3,14 Z M 11,1 L 11,5 L 15,5</Geometry>
  <Style TargetType="ListBoxItem">
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Padding" Value="8,5"/>
   <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="ListBoxItem">
     <Border x:Name="Surface" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#213651"/></Trigger>
      <Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="#294E70"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>
 <Border BorderBrush="#38506B" BorderThickness="1">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="53"/><RowDefinition/><RowDefinition Height="30"/></Grid.RowDefinitions>
   <Border Background="#17263A">
    <DockPanel LastChildFill="True">
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,6,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
      <Button Content="−" Width="41" Click="MinimizeClick" AutomationProperties.Name="{local:FjordLoc Minimize}"/>
      <Button Content="□" Width="41" Click="MaximizeClick" AutomationProperties.Name="{local:FjordLoc Resize}"/>
      <Button Content="×" Width="41" Click="CloseClick" AutomationProperties.Name="{local:FjordLoc Close}"/>
     </StackPanel>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
      <Path Data="{StaticResource FolderShape}" Stroke="#87C5FD" StrokeThickness="1.2" Fill="#2B5379" Margin="0,0,9,0"/>
      <TextBlock Text="{local:FjordLoc Title}" FontWeight="SemiBold"/>
     </StackPanel>
    </DockPanel>
   </Border>
   <Border Grid.Row="1" Background="#1C2D44" BorderBrush="#304461" BorderThickness="0,1,0,1" Padding="12,7">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="158"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
      <Button x:Name="BackButton" Content="‹" FontSize="20" Click="BackClick" AutomationProperties.Name="{local:FjordLoc Back}" ToolTip="{local:FjordLoc BackHint}"/>
      <Button x:Name="ForwardButton" Content="›" FontSize="20" Click="ForwardClick" AutomationProperties.Name="{local:FjordLoc Forward}" ToolTip="{local:FjordLoc ForwardHint}"/>
      <Button x:Name="UpButton" Content="↑" FontSize="16" Click="UpClick" AutomationProperties.Name="{local:FjordLoc Parent}" ToolTip="{local:FjordLoc ParentHint}"/>
     </StackPanel>
     <Border Grid.Column="1" Background="#142237" CornerRadius="7" Margin="0,1,8,1">
      <Grid>
       <TextBox x:Name="Location" AutomationProperties.Name="{local:FjordLoc Location}" ToolTip="{local:FjordLoc LocationHint}"
        BorderThickness="0" KeyDown="LocationKeyDown">
        <TextBox.Style>
         <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
          <Setter Property="Background" Value="Transparent"/>
          <Style.Triggers>
           <Trigger Property="IsKeyboardFocused" Value="False"><Setter Property="Foreground" Value="Transparent"/></Trigger>
          </Style.Triggers>
         </Style>
        </TextBox.Style>
       </TextBox>
       <TextBlock x:Name="Breadcrumb" Margin="10,0" VerticalAlignment="Center" Foreground="#EAF3FC"
        TextTrimming="CharacterEllipsis" IsHitTestVisible="False">
        <TextBlock.Style>
         <Style TargetType="TextBlock">
          <Style.Triggers>
           <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=Location}" Value="True">
            <Setter Property="Visibility" Value="Collapsed"/>
           </DataTrigger>
          </Style.Triggers>
         </Style>
        </TextBlock.Style>
       </TextBlock>
      </Grid>
     </Border>
     <Border Grid.Column="2" Background="#142237" CornerRadius="7" Margin="0,1,6,1">
      <DockPanel>
       <TextBlock DockPanel.Dock="Left" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="#9BB2CF" Margin="10,0,0,0" VerticalAlignment="Center"/>
       <TextBox x:Name="Search" AutomationProperties.Name="{local:FjordLoc SearchHint}" ToolTip="{local:FjordLoc SearchHint}" Background="Transparent" TextChanged="SearchChanged"/>
      </DockPanel>
     </Border>
     <Button Grid.Column="3" Content="{local:FjordLoc Preview}" Click="PreviewClick" AutomationProperties.Name="{local:FjordLoc PreviewPane}" ToolTip="{local:FjordLoc PreviewHint}"/>
    </Grid>
   </Border>
   <Grid Grid.Row="2">
    <Grid.ColumnDefinitions><ColumnDefinition Width="184"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border Background="#142237" BorderThickness="0,0,1,0" BorderBrush="#2A3C56" Padding="12,16,12,8">
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
       <TextBlock Text="{local:FjordLoc Favorites}" Foreground="#9BB2CF" FontSize="12" Margin="8,0,0,8"/>
       <StackPanel x:Name="Favorites"/>
       <TextBlock Text="{local:FjordLoc Volumes}" Foreground="#9BB2CF" FontSize="12" Margin="8,18,0,8"/>
       <StackPanel x:Name="Volumes"/>
      </StackPanel>
     </ScrollViewer>
    </Border>
    <Grid Grid.Column="1" Margin="12,8,12,8">
     <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition/></Grid.RowDefinitions>
     <Grid Margin="10,0,8,0" TextElement.Foreground="#A8BDD7">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions>
      <TextBlock Text="{local:FjordLoc Name}" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="1" Text="{local:FjordLoc Modified}" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="2" Text="{local:FjordLoc Size}" VerticalAlignment="Center"/>
     </Grid>
     <ListBox x:Name="Entries" Grid.Row="1" Background="Transparent" Foreground="#EAF3FC" BorderThickness="0"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
      MouseDoubleClick="EntryDoubleClick" SelectionChanged="EntrySelectionChanged" AutomationProperties.Name="{local:FjordLoc Items}">
      <ListBox.ContextMenu>
       <ContextMenu>
        <MenuItem Header="{local:FjordLoc Open}" Click="OpenItemClick"/>
        <MenuItem Header="{local:FjordLoc QuickLook}" Click="QuickLookClick"/>
        <MenuItem Header="{local:FjordLoc CopyPath}" Click="CopyPathClick"/>
        <MenuItem Header="{local:FjordLoc Reveal}" Click="RevealClick"/>
       </ContextMenu>
      </ListBox.ContextMenu>
      <ListBox.ItemTemplate>
       <DataTemplate>
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/><ColumnDefinition Width="78"/></Grid.ColumnDefinitions>
         <DockPanel Margin="0,0,8,0">
          <Grid DockPanel.Dock="Left" Width="25">
           <Path Width="15" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center"
            Stretch="Uniform" StrokeThickness="1.2" Stroke="#8DC7FD">
            <Path.Style>
             <Style TargetType="Path">
              <Setter Property="Data" Value="{StaticResource FileShape}"/>
              <Style.Triggers>
               <DataTrigger Binding="{Binding IsFolder}" Value="True">
                <Setter Property="Data" Value="{StaticResource FolderShape}"/>
                <Setter Property="Fill" Value="#2B5379"/>
               </DataTrigger>
              </Style.Triggers>
             </Style>
            </Path.Style>
           </Path>
          </Grid>
          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
         </DockPanel>
         <TextBlock Grid.Column="1" Text="{Binding DateLabel}" Foreground="#AEC4DD"/>
         <TextBlock Grid.Column="2" Text="{Binding SizeLabel}" Foreground="#AEC4DD"/>
        </Grid>
       </DataTemplate>
      </ListBox.ItemTemplate>
     </ListBox>
     <TextBlock x:Name="Empty" Grid.Row="1" Foreground="#A8BDD7" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
    </Grid>
    <Border x:Name="PreviewPane" Grid.Column="2" Width="262" Visibility="Collapsed" Background="#142237" BorderBrush="#2A3C56" BorderThickness="1,0,0,0" Padding="15"/>
   </Grid>
   <Border Grid.Row="3" Background="#17263A" BorderBrush="#2A3C56" BorderThickness="0,1,0,0" Padding="14,0">
    <TextBlock x:Name="Status" Foreground="#BBD0EA" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
   </Border>
  </Grid>
 </Border>
</Window>
