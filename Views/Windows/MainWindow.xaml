<Window x:Class="OpenTaskbar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OpenTaskbar.Services"
        xmlns:widgets="clr-namespace:OpenTaskbar.Views.Widgets"
        xmlns:views="clr-namespace:OpenTaskbar.Views"
        xmlns:shell="clr-namespace:OpenTaskbar.Views.Shell"
        Title="OpenTaskbar"
        Width="360"
        Height="{StaticResource DockWindowHeight}"
        MinHeight="0"
        FontFamily="{StaticResource InterfaceFont}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Auto"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Closing="Window_Closing"
        SourceInitialized="Window_SourceInitialized"
        SizeChanged="Window_SizeChanged"
        Closed="Window_Closed">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <ContextMenu x:Key="AppContextMenu" Opened="DockContextMenu_Opened" Closed="DockContextMenu_Closed">
            <Separator Tag="JumpListCommands" Visibility="Collapsed" />
            <MenuItem Header="{local:Loc OpenApplication}" Icon="{StaticResource IconOpen}" Tag="ActivateDockApp" Click="DockAppContextMenu_Click" />
            <MenuItem Header="{local:Loc Pin}" Icon="{StaticResource IconPin}" Tag="PinDockApp" Visibility="Collapsed" Click="PinDockApp_Click" />
            <MenuItem Header="{local:Loc Unpin}" Icon="{StaticResource IconUnpin}" Tag="UnpinDockApp" Visibility="Collapsed" Click="UnpinDockApp_Click" />
            <MenuItem Header="{local:Loc HideInProfile}" Icon="{StaticResource IconEyeOff}" Tag="HideInProfile" Visibility="Collapsed" Click="HideInProfile_Click" />
            <MenuItem Header="{local:Loc AddToGroup}" Icon="{StaticResource IconLayers}" Tag="AddToGroup">
                <MenuItem Header="…" />
            </MenuItem>
            <MenuItem Header="{local:Loc NewInstance}" Icon="{StaticResource IconPlus}" Tag="NewInstance" InputGestureText="{local:Loc GestureShiftClick}" Click="NewInstance_Click" />
            <MenuItem Header="{local:Loc RunAsAdmin}" Icon="{StaticResource IconShield}" Tag="RunAsAdmin" InputGestureText="{local:Loc GestureCtrlShiftClick}" Click="RunAsAdmin_Click" />
            <Separator Tag="RunningCommandsDivider" />
            <MenuItem Header="{local:Loc CloseApplication}" Icon="{StaticResource IconClose}" Tag="CloseDockApp" Click="CloseDockApp_Click" />
            <MenuItem Header="{local:Loc Terminate}" Icon="{StaticResource IconTerminate}" Style="{StaticResource DestructiveMenuItem}" Tag="TerminateDockApp" Click="TerminateDockApp_Click" />
        </ContextMenu>
        <ContextMenu x:Key="DockContextMenu" Opened="DockContextMenu_Opened" Closed="DockContextMenu_Closed">
            <MenuItem Header="{local:Loc OpenLauncher}" Icon="{StaticResource IconSearch}" Click="OpenSearch_Click" />
            <MenuItem Header="{local:Loc PinApplication}" Icon="{StaticResource IconPin}" Click="PinApplication_Click" />
            <MenuItem Header="{local:Loc AddStack}" Icon="{StaticResource IconFolderPlus}" Click="AddStack_Click" />
            <MenuItem Header="{local:Loc NewGroup}" Icon="{StaticResource IconLayers}" Tag="NewGroup" Click="NewGroup_Click" />
            <MenuItem Header="{local:Loc Profiles}" Icon="{StaticResource IconLayers}" Tag="ProfilesMenu">
                <MenuItem Header="…" />
            </MenuItem>
            <MenuItem Header="{local:Loc FocusMode}" Icon="{StaticResource IconEyeOff}" Tag="FocusModeMenu" IsCheckable="True" Click="ToggleFocusMode_Click" />
            <Separator />
            <MenuItem Header="{local:Loc CheckForUpdates}" Icon="{StaticResource IconRefresh}" Tag="UpdateMenu" Click="CheckUpdates_Click" />
            <MenuItem Header="{local:Loc TaskManager}" Icon="{StaticResource IconTaskManager}" Click="OpenTaskManager_Click" />
            <Separator />
            <MenuItem Header="{local:FjordLoc Title}" Icon="{StaticResource IconFolder}" Tag="FjordFilesMenu" Click="OpenFjordFiles_Click" />
            <MenuItem Header="{local:Loc OpenFileExplorer}" Icon="{StaticResource IconFolder}" Click="OpenFileExplorer_Click" />
            <MenuItem Header="{local:Loc OpenRunDialog}" Icon="{StaticResource IconSearch}" Click="OpenRunDialog_Click" />
            <MenuItem Header="{local:Loc OpenTerminal}" Icon="{StaticResource IconTerminal}" Click="OpenTerminal_Click" />
            <MenuItem Header="{local:Loc OpenTerminalAdmin}" Icon="{StaticResource IconTerminal}" Click="OpenTerminalAdmin_Click" />
            <MenuItem Header="{local:Loc OpenDeviceManager}" Icon="{StaticResource IconCpu}" Click="OpenDeviceManager_Click" />
            <MenuItem Header="{local:Loc OpenDiskManagement}" Icon="{StaticResource IconHardDrive}" Click="OpenDiskManagement_Click" />
            <MenuItem Header="{local:Loc OpenComputerManagement}" Icon="{StaticResource IconMonitor}" Click="OpenComputerManagement_Click" />
            <MenuItem Header="{local:Loc OpenEventViewer}" Icon="{StaticResource IconClock}" Click="OpenEventViewer_Click" />
            <MenuItem Header="{local:Loc OpenNetworkConnections}" Icon="{StaticResource IconWifi}" Click="OpenNetworkConnections_Click" />
            <Separator />
            <MenuItem Header="{local:Loc LockWorkstation}" Icon="{StaticResource IconExit}" Click="LockWorkstation_Click" />
            <MenuItem Header="{local:Loc SignOut}" Icon="{StaticResource IconExit}" Click="SignOut_Click" />
            <MenuItem Header="{local:Loc RestartComputer}" Icon="{StaticResource IconRefresh}" Click="RestartComputer_Click" />
            <MenuItem Header="{local:Loc ShutDownComputer}" Icon="{StaticResource IconExit}" Click="ShutDownComputer_Click" />
            <Separator />
            <MenuItem Header="{local:Loc Settings}" Icon="{StaticResource IconSettings}" Click="OpenSettings_Click" />
            <Separator />
            <MenuItem Header="{local:Loc RemoveWidget}" Icon="{StaticResource IconTrash}" Tag="RemoveWidgetMenu" Visibility="Collapsed" Click="RemoveWidgetMenu_Click" />
            <MenuItem Header="{local:Loc Exit}" Icon="{StaticResource IconExit}" Click="ExitOpenTaskbar_Click" />
        </ContextMenu>
        <ContextMenu x:Key="GroupContextMenu" Opened="DockContextMenu_Opened" Closed="DockContextMenu_Closed">
            <MenuItem Header="{local:Loc RenameGroup}" Icon="{StaticResource IconSettings}" Tag="RenameGroup" Click="RenameGroup_Click" />
            <MenuItem Header="{local:Loc DeleteGroup}" Icon="{StaticResource IconClose}" Tag="DeleteGroup" Click="DeleteGroup_Click" Style="{StaticResource DestructiveMenuItem}" />
        </ContextMenu>

        <Style x:Key="PreviewCloseButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceSelected}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SurfaceDanger}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SurfaceDanger}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="DockAppIconTemplate">
            <Button Style="{StaticResource DockButton}" Tag="{Binding ExecutablePath}"
                    Click="DockApp_Click" AutomationProperties.Name="{Binding Name}"
                    ToolTip="{Binding Name}" ToolTipService.InitialShowDelay="650" ContextMenu="{StaticResource AppContextMenu}"
                    Loaded="DockAppButton_Loaded"
                    PreviewMouseLeftButtonDown="DockApp_PreviewMouseLeftButtonDown"
                    PreviewMouseLeftButtonUp="DockApp_PreviewMouseLeftButtonUp"
                    PreviewMouseMove="DockApp_PreviewMouseMove"
                    PreviewKeyDown="DockApp_PreviewKeyDown"
                    AllowDrop="True"
                    Drop="DockApp_Drop"
                    DragOver="DockApp_DragOver"
                    DragLeave="DockApp_DragLeave"
                    MouseEnter="DockApp_MouseEnter" MouseLeave="DockApp_MouseLeave"
                    MouseUp="DockApp_MouseUp" MouseWheel="DockApp_MouseWheel">
                <Grid Width="{DynamicResource DockIconSize}" Height="{DynamicResource DockIconSize}"
                      RenderTransformOrigin="0.5,0.5">
                    <Image Source="{Binding Icon}" Width="{DynamicResource DockApplicationIconSize}" Height="{DynamicResource DockApplicationIconSize}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Stretch="Uniform" ClipToBounds="True" RenderOptions.BitmapScalingMode="HighQuality" />
                    <Ellipse Width="9" Height="9" Fill="{DynamicResource NotificationBrush}"
                             Stroke="{DynamicResource SurfacePopup}" StrokeThickness="1"
                             HorizontalAlignment="Right" VerticalAlignment="Top"
                             Visibility="{Binding HasNotification, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="DockGroupIconTemplate">
            <Button Style="{StaticResource DockButton}" Tag="{Binding Id}"
                    Click="DockGroup_Click" AutomationProperties.Name="{Binding Name}"
                    ToolTip="{Binding Name}" ToolTipService.InitialShowDelay="650" ContextMenu="{StaticResource GroupContextMenu}"
                    AllowDrop="True" Drop="DockGroup_Drop" DragOver="DockGroup_DragOver" DragLeave="DockGroup_DragLeave"
                    PreviewMouseLeftButtonDown="DockGroup_PreviewMouseLeftButtonDown"
                    PreviewMouseLeftButtonUp="DockGroup_PreviewMouseLeftButtonUp"
                    PreviewMouseMove="DockGroup_PreviewMouseMove"
                    MouseEnter="DockApp_MouseEnter" MouseLeave="DockApp_MouseLeave" MouseUp="DockApp_MouseUp">
                <Grid Width="{DynamicResource DockIconSize}" Height="{DynamicResource DockIconSize}" RenderTransformOrigin="0.5,0.5">
                    <Grid Width="{DynamicResource DockApplicationIconSize}" Height="{DynamicResource DockApplicationIconSize}"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Initial}"
                                   FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <Image Source="{Binding Icon}" Stretch="Uniform" ClipToBounds="True" RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Style.Triggers>
                                        <Trigger Property="Source" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>

                        </Image>
                    </Grid>
                    <Border Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,-2,-2" CornerRadius="8" Background="{DynamicResource SurfaceSelected}"
                            BorderBrush="{DynamicResource SurfacePopup}" BorderThickness="1">
                        <TextBlock Text="{Binding MemberCount}" FontSize="9" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimary}" />
                    </Border>
                </Grid>
            </Button>
        </DataTemplate>
        <ContextMenu x:Key="StackContextMenu" Opened="DockContextMenu_Opened" Closed="DockContextMenu_Closed">
            <MenuItem Header="{local:Loc OpenFolder}" Icon="{StaticResource IconOpen}" Click="StackOpenFolder_Click" />
            <MenuItem Header="{local:Loc RemoveStack}" Icon="{StaticResource IconClose}" Click="StackRemove_Click" />
        </ContextMenu>

        <DataTemplate x:Key="StackIconTemplate">
            <Button Style="{StaticResource DockButton}" Click="Stack_Click" AutomationProperties.Name="{Binding Name}"
                    ToolTip="{Binding Name}" ToolTipService.InitialShowDelay="650" ContextMenu="{StaticResource StackContextMenu}"
                    AllowDrop="True"
                    PreviewMouseLeftButtonDown="StackButton_PreviewMouseLeftButtonDown"
                    PreviewMouseLeftButtonUp="StackButton_PreviewMouseLeftButtonUp"
                    PreviewMouseMove="StackButton_PreviewMouseMove"
                    DragOver="StackButton_DragOver"
                    DragLeave="StackButton_DragLeave"
                    Drop="StackButton_Drop">
                <Grid Width="{DynamicResource DockIconSize}" Height="{DynamicResource DockIconSize}" RenderTransformOrigin="0.5,0.5">
                    <Image Source="{Binding Icon}" Width="{DynamicResource DockApplicationIconSize}" Height="{DynamicResource DockApplicationIconSize}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">

                    </Image>
                    <Ellipse Width="9" Height="9" Fill="{DynamicResource NotificationBrush}"
                             Stroke="{DynamicResource SurfacePopup}" StrokeThickness="1"
                             HorizontalAlignment="Right" VerticalAlignment="Top"
                             Visibility="{Binding HasNewItems, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="DockHost" ToolTipService.Placement="Custom">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="DockHeadroomRow" Height="{Binding Source={StaticResource DockHeadroom}}" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- Catches clicks only while the shelf area is reserved (auto-hide off); otherwise windows below stay clickable. -->
        <Border x:Name="DockBackdrop" Grid.Row="1" Background="#01000000" ContextMenu="{StaticResource DockContextMenu}" />
        <Grid x:Name="DockSurface" Grid.Row="1" HorizontalAlignment="Stretch"
              Margin="{StaticResource DockInset}" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1"
              ContextMenu="{StaticResource DockContextMenu}"
              SizeChanged="DockSurface_SizeChanged"
              MouseEnter="DockSurface_MouseEnter" MouseMove="DockSurface_MouseMove" MouseLeave="DockSurface_MouseLeave"
              MouseWheel="DockSurface_MouseWheel">
            <Grid.RenderTransform>
                <TransformGroup>
                    <TranslateTransform x:Name="DockSurfaceTranslate" Y="0" />
                    <ScaleTransform x:Name="DockScaleTransform" ScaleX="1" ScaleY="1" />
                </TransformGroup>
            </Grid.RenderTransform>
            <!-- Keep DropShadowEffect on a sibling pill behind DockFrame so magnifying icons protruding above
                 DockFrame never force WPF to resize/resample an offscreen Effect bitmap containing Start and widgets.
                 Explicit BitmapCache keeps the blur-36 shadow raster cached on GPU across hover frames. -->
            <Border x:Name="DockShadowLayer"
                    Background="{DynamicResource DockMaterial}"
                    BorderBrush="{DynamicResource DockBorderMaterial}"
                    BorderThickness="{DynamicResource DockBorderThickness}"
                    CornerRadius="{Binding CornerRadius, ElementName=DockFrame}"
                    Effect="{DynamicResource DockShadow}"
                    IsHitTestVisible="False">
                <Border.CacheMode>
                    <BitmapCache EnableClearType="False" RenderAtScale="1" SnapsToDevicePixels="True" />
                </Border.CacheMode>
            </Border>
            <Border x:Name="DockFrame" Padding="{StaticResource DockPadding}"
                    Background="Transparent" BorderBrush="Transparent"
                    BorderThickness="{DynamicResource DockBorderThickness}" CornerRadius="{DynamicResource DockRadius}"
                    AllowDrop="True" DragOver="DockFrame_DragOver" Drop="DockFrame_Drop">
                <Grid x:Name="DockFrameRoot">
                    <Grid.RenderTransform>
                        <!-- Burn-in shift never affects layout; only a tiny visual drift inside the pill. -->
                        <TranslateTransform x:Name="DockBurnInShift" X="0" Y="0" />
                    </Grid.RenderTransform>
                    <Grid x:Name="DockLayoutRoot">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="LeadColumn" Width="Auto" />
                            <ColumnDefinition x:Name="AppsColumn" Width="*" />
                            <ColumnDefinition x:Name="TrailColumn" Width="Auto" />
                            <ColumnDefinition x:Name="WidgetColumn" Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="DockLeadControls" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                                    Margin="3,0,0,0" AllowDrop="True" DragOver="DockLeadControls_DragOver" Drop="DockLeadControls_Drop">
                            <Button x:Name="StartButton" Style="{StaticResource StartDockButton}" Click="StartButton_Click"
                                    PreviewMouseLeftButtonDown="StartButton_PreviewMouseLeftButtonDown"
                                    AutomationProperties.Name="{local:Loc Start}" ToolTip="{local:Loc Start}" ToolTipService.InitialShowDelay="650">
                                <Grid Width="{DynamicResource DockIconSize}" Height="{DynamicResource DockIconSize}"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="1" ScaleY="1" />
                                            <TranslateTransform Y="0" />
                                        </TransformGroup>
                                    </Grid.RenderTransform>
                                    <Image x:Name="StartImage" Visibility="Collapsed" Stretch="Uniform"
                                           Width="{DynamicResource DockApplicationIconSize}" Height="{DynamicResource DockApplicationIconSize}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality">

                                    </Image>
                                    <Path x:Name="StartLogo" Width="{DynamicResource DockApplicationIconSize}" Height="{DynamicResource DockApplicationIconSize}" Stretch="Uniform" Fill="{DynamicResource WindowsLogoBrush}"
                                          MaxWidth="{DynamicResource DockIconSize}" MaxHeight="{DynamicResource DockIconSize}"
                                          Data="M0,0 H10 V10 H0 Z M12,0 H22 V10 H12 Z M0,12 H10 V22 H0 Z M12,12 H22 V22 H12 Z">

                                    </Path>
                                </Grid>
                            </Button>
                            <Button x:Name="SearchButton" Style="{StaticResource ShellDockButton}" Click="SearchButton_Click"
                                    PreviewMouseLeftButtonDown="ShellButton_PreviewMouseLeftButtonDown"
                                    PreviewMouseMove="ShellButton_PreviewMouseMove"
                                    PreviewMouseLeftButtonUp="ShellButton_PreviewMouseLeftButtonUp"
                                    AutomationProperties.Name="{local:Loc WidgetLauncher}" ToolTip="{local:Loc WidgetLauncher}"
                                    ToolTipService.InitialShowDelay="650">
                                <Grid Width="{DynamicResource DockIconSize}" Height="{DynamicResource DockIconSize}"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="1" ScaleY="1" />
                                            <TranslateTransform Y="0" />
                                        </TransformGroup>
                                    </Grid.RenderTransform>
                                    <ContentControl Style="{StaticResource WidgetIcon}" Content="{StaticResource IconSearch}"
                                                    Width="{DynamicResource DockUtilityGlyphSize}"
                                                    Height="{DynamicResource DockUtilityGlyphSize}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Foreground="{DynamicResource TextPrimary}" />
                                </Grid>
                            </Button>
                            <Button x:Name="FjordFilesButton" Style="{StaticResource ShellDockButton}" Click="OpenFjordFiles_Click"
                                    AutomationProperties.Name="{local:FjordLoc Title}" ToolTip="{local:FjordLoc Title}">
                                <Grid Width="{DynamicResource DockIconSize}" Height="{DynamicResource DockIconSize}" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="1" ScaleY="1" />
                                            <TranslateTransform Y="0" />
                                        </TransformGroup>
                                    </Grid.RenderTransform>
                                    <ContentControl Style="{StaticResource WidgetIcon}" Content="{StaticResource IconFolder}"
                                                    Width="{DynamicResource DockUtilityGlyphSize}" Height="{DynamicResource DockUtilityGlyphSize}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Foreground="{DynamicResource TextPrimary}" />
                                </Grid>
                            </Button>
                            <Button x:Name="TaskViewButton" Style="{StaticResource ShellDockButton}" Click="TaskViewButton_Click"
                                    PreviewMouseLeftButtonDown="ShellButton_PreviewMouseLeftButtonDown"
                                    PreviewMouseMove="ShellButton_PreviewMouseMove"
                                    PreviewMouseLeftButtonUp="ShellButton_PreviewMouseLeftButtonUp"
                                    AutomationProperties.Name="{local:Loc WidgetDesktops}" ToolTip="{local:Loc WidgetDesktops}"
                                    ToolTipService.InitialShowDelay="650">
                                <Button.ContextMenu>
                                    <ContextMenu Opened="DockContextMenu_Opened" Closed="DockContextMenu_Closed">
                                        <MenuItem Header="{local:Loc DesktopPrevious}" Click="PreviousDesktop_Click" />
                                        <MenuItem Header="{local:Loc DesktopNext}" Click="NextDesktop_Click" />
                                        <MenuItem Header="{local:Loc DesktopNew}" Click="NewDesktop_Click" />
                                        <Separator />
                                        <MenuItem Header="{local:Loc DesktopTaskView}" Click="TaskViewButton_Click" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <Grid Width="{DynamicResource DockIconSize}" Height="{DynamicResource DockIconSize}" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="1" ScaleY="1" />
                                            <TranslateTransform Y="0" />
                                        </TransformGroup>
                                    </Grid.RenderTransform>
                                    <ContentControl Style="{StaticResource WidgetIcon}" Content="{StaticResource IconDesktops}"
                                                    Width="{DynamicResource DockUtilityGlyphSize}"
                                                    Height="{DynamicResource DockUtilityGlyphSize}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Foreground="{DynamicResource TextPrimary}" />
                                </Grid>
                            </Button>
                            <shell:PinnedTrayStrip x:Name="PinnedTrayStrip" Visibility="Collapsed" />
                            <shell:TrayShellButton x:Name="TrayButton" Style="{StaticResource ShellDockButton}"
                                                   PreviewMouseLeftButtonDown="ShellButton_PreviewMouseLeftButtonDown"
                                                   PreviewMouseMove="ShellButton_PreviewMouseMove"
                                                   PreviewMouseLeftButtonUp="ShellButton_PreviewMouseLeftButtonUp"
                                                   ToolTipService.InitialShowDelay="650" />
                        </StackPanel>
                        <views:DockScrollViewer x:Name="DockScrollViewer" Grid.Column="1" HorizontalAlignment="Left" Style="{StaticResource DockScrollViewerStyle}"
                                              HoverHeadroom="{StaticResource DockHeadroom}" ContentInset="{StaticResource DockScrollContentInset}"
                                              ScrollViewer.ScrollChanged="DockScrollViewer_ScrollChanged">
                            <StackPanel x:Name="DockContents" Orientation="Horizontal" HorizontalAlignment="Left"
                                        VerticalAlignment="Center" Background="Transparent" AllowDrop="True"
                                        DragOver="DockContents_DragOver" Drop="DockContents_Drop">
                                <ItemsControl x:Name="PinnedApps" ItemTemplate="{StaticResource DockAppIconTemplate}" Visibility="Collapsed">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <Border x:Name="RunningAppsDivider" Width="0" Height="22" Background="Transparent" Margin="0" Visibility="Collapsed" IsHitTestVisible="False" />
                                <ItemsControl x:Name="RunningApps" ItemTemplate="{StaticResource DockAppIconTemplate}" Visibility="Collapsed">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <!-- Kept in the tree for layout code, but invisible and transparent to dragging so apps and folder stacks can be moved freely across the whole strip. -->
                                <Border x:Name="ExtrasDivider" Width="0" Height="22" Background="Transparent" Margin="0" Visibility="Collapsed" IsHitTestVisible="False" />
                                <ItemsControl x:Name="StackItems" ItemTemplate="{StaticResource StackIconTemplate}" Visibility="Collapsed">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <!-- Boundaries of the shell group and the tray button; positioned by RebuildDockOrder. -->
                                <Border x:Name="StartDivider" Width="2" Height="22" Background="{DynamicResource TextSecondary}"
                                        Margin="3,0,4,0" IsHitTestVisible="False" Visibility="Collapsed" />
                                <Border x:Name="TrayGroupDivider" Width="2" Height="22" Background="{DynamicResource TextSecondary}"
                                        Margin="6,0,4,0" IsHitTestVisible="False" Visibility="Collapsed" />
                                <TextBlock x:Name="StatusText" Foreground="{DynamicResource DangerText}" FontSize="{StaticResource TextSizeCaption}"
                                           MaxWidth="280" VerticalAlignment="Center" Margin="8,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </views:DockScrollViewer>
                        <StackPanel x:Name="DockTrailControls" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                    Margin="0,0,3,0" AllowDrop="True" DragOver="DockTrailControls_DragOver" Drop="DockTrailControls_Drop">
                            <Button x:Name="RecycleBinButton" Style="{StaticResource ShellDockButton}" Click="RecycleBin_Click"
                                    AllowDrop="True" DragOver="RecycleBin_DragOver" Drop="RecycleBin_Drop"
                                    AutomationProperties.Name="{local:Loc RecycleBin}" ToolTip="{local:Loc RecycleBin}" ToolTipService.InitialShowDelay="650">
                                <Button.ContextMenu>
                                    <ContextMenu Opened="DockContextMenu_Opened" Closed="DockContextMenu_Closed">
                                        <MenuItem Header="{local:Loc OpenRecycleBin}" Icon="{StaticResource IconOpen}" Click="RecycleBin_Click" />
                                        <MenuItem x:Name="EmptyRecycleBinItem" Header="{local:Loc EmptyRecycleBin}" Icon="{StaticResource IconTrash}"
                                                  Style="{StaticResource DestructiveMenuItem}" Click="EmptyRecycleBin_Click" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <Grid Width="{DynamicResource DockIconSize}" Height="{DynamicResource DockIconSize}" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="1" ScaleY="1" />
                                            <TranslateTransform Y="0" />
                                        </TransformGroup>
                                    </Grid.RenderTransform>
                                    <Image x:Name="RecycleBinIcon" Width="{DynamicResource DockApplicationIconSize}" Height="{DynamicResource DockApplicationIconSize}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">

                                    </Image>
                                </Grid>
                            </Button>
                            <Border x:Name="WidgetDivider" Width="2" Height="22" Background="{DynamicResource TextSecondary}" Margin="6,0" Visibility="Collapsed" IsHitTestVisible="False" />
                            <ItemsControl x:Name="DockWidgets" SizeChanged="DockWidgets_SizeChanged" Visibility="Collapsed">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Center" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                        <!-- Widgets follow the apps in floating mode and pin to the right edge in full-width mode. -->
                        <Border x:Name="WidgetIsland" Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="4,0,0,0"
                                Padding="0" BorderThickness="0" Background="Transparent" BorderBrush="Transparent">
                            <StackPanel x:Name="WidgetStrip" Orientation="Horizontal" VerticalAlignment="Center"
                                        AllowDrop="True" DragOver="WidgetStrip_DragOver" Drop="WidgetStrip_Drop"
                                        SizeChanged="WidgetStrip_SizeChanged" />
                        </Border>
                    </Grid>
                    <!-- Internal legacy bevel collapsed to prevent duplicate inner box borders -->
                    <Border x:Name="DockInnerBevel" Visibility="Collapsed" IsHitTestVisible="False" />
                    <!-- Clean, calm glass surface without artificial specular glints or neon glow overlays -->
                    <Border x:Name="DockSheen" Visibility="Collapsed" IsHitTestVisible="False" />
                    <Border x:Name="DockDynamicGlintBorder" Visibility="Collapsed" IsHitTestVisible="False" />
                    <Border x:Name="DockDynamicGlowBorder" Visibility="Collapsed" IsHitTestVisible="False" />
                    <StackPanel x:Name="AmbientPanel" Orientation="Horizontal" VerticalAlignment="Center"
                                HorizontalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"
                                Margin="14,0">
                        <TextBlock x:Name="AmbientClockText" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                        <Rectangle Width="1" Height="14" Fill="{DynamicResource StrokeSubtle}" Margin="10,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="AmbientBatteryText" FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
            <Button x:Name="ShowDesktopButton" Style="{StaticResource DockButton}" Width="6"
                    Click="ShowDesktop_Click" Cursor="Hand"
                    AllowDrop="True"
                    DragOver="ShowDesktopButton_DragOver"
                    DragLeave="ShowDesktopButton_DragLeave"
                    Drop="ShowDesktopButton_Drop"
                    MouseUp="ShowDesktopButton_MouseUp"
                    IsVisibleChanged="ShowDesktop_IsVisibleChanged"
                    PreviewMouseLeftButtonDown="ShellButton_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ShellButton_PreviewMouseMove"
                    PreviewMouseLeftButtonUp="ShellButton_PreviewMouseLeftButtonUp"
                    AutomationProperties.Name="{local:Loc ShowDesktop}" ToolTip="{local:Loc ShowDesktopTooltip}"
                    ToolTipService.InitialShowDelay="650" Margin="0"
                    HorizontalAlignment="Right" VerticalAlignment="Stretch"
                    Panel.ZIndex="11">
                <Button.ContextMenu>
                    <ContextMenu Opened="DockContextMenu_Opened" Closed="DockContextMenu_Closed">
                        <MenuItem Header="{local:Loc ShowDesktop}" Icon="{StaticResource IconMonitor}" Click="ShowDesktop_Click" />
                        <MenuItem Header="{local:Loc OpenDesktopFolder}" Icon="{StaticResource IconFolder}" Click="OpenDesktopFolder_Click" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <!-- Scroll edge overlays: scrim and chevron sit flush at the outer dock edges, right beside the resize thumbs -->
            <Button x:Name="ScrollPrevOverlay"
                    HorizontalAlignment="Left" VerticalAlignment="Stretch"
                    Width="28" Margin="1,1,0,1"
                    Background="{DynamicResource DockScrollScrimStart}"
                    Style="{StaticResource DockScrollIndicatorButton}"
                    HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                    Padding="7,0,0,0"
                    Tag="19,0,0,19"
                    Click="ScrollPrevOverlay_Click"
                    Panel.ZIndex="9"
                    AutomationProperties.Name="{local:Loc ScrollDockHelp}" ToolTip="{local:Loc ScrollDockHelp}" />
            <Button x:Name="ScrollNextOverlay"
                    HorizontalAlignment="Right" VerticalAlignment="Stretch"
                    Width="28" Margin="0,1,1,1"
                    Background="{DynamicResource DockScrollScrimEnd}"
                    Style="{StaticResource DockScrollIndicatorButton}"
                    HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
                    Padding="0,0,7,0"
                    Tag="0,19,19,0"
                    Click="ScrollNextOverlay_Click"
                    Panel.ZIndex="9"
                    AutomationProperties.Name="{local:Loc ScrollDockHelp}" ToolTip="{local:Loc ScrollDockHelp}" />
            <Thumb x:Name="LeftResizeThumb" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                   Panel.ZIndex="10"
                   Style="{StaticResource DockResizeThumb}" DragStarted="DockResizeThumb_DragStarted"
                   DragDelta="DockResizeThumb_DragDelta" DragCompleted="DockResizeThumb_DragCompleted"
                   MouseDoubleClick="DockResizeThumb_MouseDoubleClick"
                   AutomationProperties.Name="{local:Loc ResizeDockFromLeft}" />
            <Thumb x:Name="RightResizeThumb" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                   Panel.ZIndex="10"
                   Style="{StaticResource DockResizeThumb}" DragStarted="DockResizeThumb_DragStarted"
                   DragDelta="DockResizeThumb_DragDelta" DragCompleted="DockResizeThumb_DragCompleted"
                   MouseDoubleClick="DockResizeThumb_MouseDoubleClick"
                   AutomationProperties.Name="{local:Loc ResizeDockFromRight}" />
        </Grid>
        <Border x:Name="DockEdgeTrigger" Grid.Row="1" VerticalAlignment="Bottom" Height="{StaticResource DockEdgeTriggerHeight}" Background="#01000000"
                MouseEnter="DockEdgeTrigger_MouseEnter" MouseLeave="DockEdgeTrigger_MouseLeave" />
    </Grid>
</Window>
