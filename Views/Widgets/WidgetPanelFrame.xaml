<UserControl x:Class="OpenTaskbar.Views.Widgets.WidgetPanelFrame"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OpenTaskbar.Services"
             Width="{StaticResource WidgetPanelWidth}" FontFamily="{StaticResource InterfaceFont}"
             FontSize="{StaticResource TextSizeBody}" Foreground="{DynamicResource TextPrimary}"
             KeyboardNavigation.TabNavigation="Cycle">
    <Border Background="{DynamicResource WidgetMaterial}" BorderBrush="{DynamicResource WidgetStrokeMaterial}" BorderThickness="1"
            CornerRadius="16" ClipToBounds="True">
        <Grid>
            <Border Height="36" VerticalAlignment="Top" CornerRadius="15,15,0,0"
                    Background="{DynamicResource WidgetSheenMaterial}" IsHitTestVisible="False" />
            <ScrollViewer Padding="{StaticResource WidgetPanelPadding}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="&#xE8BB;" Style="{StaticResource WidgetButton}"
                                Width="{StaticResource WidgetQuickActionSize}" Height="{StaticResource WidgetQuickActionSize}"
                                FontFamily="{StaticResource WidgetActionFont}" HorizontalContentAlignment="Center"
                                Click="Close_Click" AutomationProperties.Name="{local:Loc Close}" ToolTip="{local:Loc Close}" />
                        <TextBlock Text="{Binding Heading, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   FontSize="{StaticResource WidgetPanelHeadingSize}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                    <ContentPresenter x:Name="BodyPresenter" Content="{Binding Body, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      Margin="{StaticResource WidgetPanelFieldMargin}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
