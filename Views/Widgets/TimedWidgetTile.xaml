<UserControl x:Class="OpenTaskbar.Views.Widgets.TimedWidgetTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OpenTaskbar.Services"
             xmlns:views="clr-namespace:OpenTaskbar.Views"
             Focusable="False" Foreground="{DynamicResource TextPrimary}" FontFamily="{StaticResource InterfaceFont}">
    <Border>
        <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource WidgetCardBorder}">
                <Setter Property="Padding" Value="10,0,6,0" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCompact}" Value="True">
                        <Setter Property="Padding" Value="8,0,8,0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ContentControl x:Name="TileIcon" Grid.Column="0"
                            Content="{StaticResource IconTimer}"
                            Width="16" Height="16"
                            VerticalAlignment="Center">
                <ContentControl.Style>
                    <Style TargetType="ContentControl" BasedOn="{StaticResource WidgetIcon}">
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                        <Setter Property="Margin" Value="0,0,7,0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource WidgetSelectedForeground}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCompact}" Value="True">
                                <Setter Property="Margin" Value="0,0,5,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>

            <TextBlock x:Name="IslandTitleText" Grid.Column="1"
                       Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Margin="0,0,8,0" MaxWidth="86" VerticalAlignment="Center"
                       FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                       TextTrimming="CharacterEllipsis">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDynamicIsland, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Button x:Name="DetailsButton" Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="2,0,4,0"
                    Cursor="Hand" FocusVisualStyle="{x:Null}" Click="Details_Click"
                    views:WidgetCardFeedback.PropagatesCardPress="True"
                    HorizontalContentAlignment="Left" VerticalContentAlignment="Center" ToolTip="{local:Loc WidgetOpenDetails}"
                    AutomationProperties.Name="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    AutomationProperties.HelpText="{local:Loc WidgetOpenDetails}" AutomationProperties.ItemStatus="{Binding Value}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock x:Name="ValueText" Typography.NumeralAlignment="Tabular" FontWeight="SemiBold"
                           FontSize="13" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{Binding Value}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Value}" Value="">
                                    <Setter Property="Text" Value="{local:Loc WidgetSetDuration}" />
                                    <Setter Property="FontSize" Value="11.5" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Button>

            <Button x:Name="ResetButton" Grid.Column="3" Width="25" Height="28" Margin="2,0,2,0"
                    Click="Reset_Click" ToolTip="{local:Loc TimedWidgetReset}"
                    AutomationProperties.Name="{local:Loc TimedWidgetReset}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource WidgetIconButton}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDynamicIsland, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <ContentControl Width="12" Height="12" Content="{StaticResource IconReset}"
                                Style="{StaticResource WidgetGlyph}" />
            </Button>

            <Button x:Name="QuickActionButton" Grid.Column="4"
                    Width="36" Height="36" Margin="4,0,0,0" VerticalAlignment="Center" Click="QuickAction_Click">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource WidgetIconButton}">
                        <Setter Property="ToolTip" Value="{local:Loc TimedWidgetStart}" />
                        <Setter Property="AutomationProperties.Name" Value="{local:Loc TimedWidgetStart}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <Setter Property="ToolTip" Value="{local:Loc TimedWidgetPause}" />
                                <Setter Property="AutomationProperties.Name" Value="{local:Loc TimedWidgetPause}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CanToggle}" Value="False">
                                <Setter Property="ToolTip" Value="{local:Loc WidgetSetDuration}" />
                                <Setter Property="AutomationProperties.Name" Value="{local:Loc WidgetSetDuration}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCompact}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsDynamicIsland, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Border Width="26" Height="26" CornerRadius="7" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource WidgetSelectedFill}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource WidgetSelectedStroke}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ContentControl x:Name="ActionGlyph" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl" BasedOn="{StaticResource WidgetGlyph}">
                                <Setter Property="Content" Value="{StaticResource IconPlayFill}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Content" Value="{StaticResource IconPauseFill}" />
                                        <Setter Property="Foreground" Value="{DynamicResource WidgetSelectedForeground}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CanToggle}" Value="False">
                                        <Setter Property="Content" Value="{StaticResource IconReset}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </Border>
            </Button>
        </Grid>
    </Border>
</UserControl>
