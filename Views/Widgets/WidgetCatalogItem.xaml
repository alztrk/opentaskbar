<UserControl x:Class="OpenTaskbar.Views.Widgets.WidgetCatalogItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OpenTaskbar.Services"
             FontFamily="{DynamicResource InterfaceFont}"
             Foreground="{DynamicResource TextPrimary}" Focusable="False">
    <Border x:Name="CardBorder" BorderThickness="1"
            CornerRadius="8" Margin="0,0,0,7" SnapsToDevicePixels="True">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{DynamicResource StrokeSubtle}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SettingsControlHover}" />
                    </Trigger>
                    <DataTrigger Binding="{Binding IsSettingsExpanded}" Value="True">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="{DynamicResource StrokeFocus}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <StackPanel>
            <Grid MinHeight="48">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSettingsExpanded}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceSelected}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="PreviewButton" Click="Preview_Click" Cursor="Hand"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource TextPrimary}"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                        AutomationProperties.Name="{Binding Label}"
                        AutomationProperties.HelpText="{Binding Description}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Grid Margin="13,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ContentControl Grid.Column="0" Content="{Binding IconGeometry}" Width="16" Height="16"
                                        Margin="0,0,10,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl" BasedOn="{StaticResource WidgetIcon}">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFilledIcon}" Value="True">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ContentControl">
                                                        <Viewbox>
                                                            <Canvas Width="24" Height="24">
                                                                <Path Data="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                                                      Fill="{TemplateBinding Foreground}" />
                                                            </Canvas>
                                                        </Viewbox>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>
                        <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12.5" FontWeight="Medium"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Grid.Column="1" Text="{local:Loc WidgetUnavailable}" FontSize="10"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0"
                                   Foreground="{DynamicResource TextSecondary}" Visibility="{Binding UnavailableVisibility}"/>
                        <TextBlock Grid.Column="2" Text="{Binding SettingsGlyph}" FontFamily="Segoe MDL2 Assets"
                                   FontSize="9" VerticalAlignment="Center" Margin="8,0,2,0"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </Grid>
                </Button>
                <Button x:Name="InstallButton" Grid.Column="1" Width="38" MinHeight="38" Margin="0,5,6,5"
                        Click="Install_Click" Background="Transparent" BorderThickness="0"
                        IsEnabled="{Binding IsHardwareAvailable}"
                        Foreground="{DynamicResource TextSecondary}"
                        ToolTip="{Binding InstallActionLabel}" Cursor="Hand"
                        AutomationProperties.Name="{Binding InstallActionLabel}"
                        AutomationProperties.ItemStatus="{Binding InstallStatus}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Style="{StaticResource WidgetCatalogInstallMark}" HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Button>
            </Grid>
            <Border x:Name="SettingsDrawer" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource StrokeSubtle}"
                    Padding="20,16,20,18">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSettingsExpanded}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1"
                                                Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <Button x:Name="CloseButton" DockPanel.Dock="Right"
                                Style="{StaticResource SettingsGhostButton}" VerticalAlignment="Center"
                                Click="Close_Click" Padding="7,4" FontSize="11"
                                ToolTip="{local:Loc Close}" AutomationProperties.Name="{local:Loc Close}">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                       Foreground="{DynamicResource TextSecondary}" />
                        </Button>
                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="15"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" />
                    </DockPanel>
                    <!-- Preview first, full width, with the settings below it. -->
                    <Border MinHeight="104" Padding="16,12" Margin="0,0,0,10" CornerRadius="8"
                            Background="{DynamicResource SurfaceSelected}" BorderThickness="1"
                            BorderBrush="{DynamicResource StrokeSubtle}">
                        <Grid>
                            <ContentControl Content="{Binding PreviewContent}" HorizontalAlignment="Stretch"
                                            VerticalAlignment="Center" Focusable="False"
                                            IsHitTestVisible="False" KeyboardNavigation.TabNavigation="None"/>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Click="FlyoutPreview_Click"
                                    Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="4,2"
                                    ToolTip="{local:Loc PreviewFlyout}"
                                    AutomationProperties.Name="{local:Loc PreviewFlyout}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="{Binding FlyoutPreviewGlyph}" FontFamily="Segoe MDL2 Assets"
                                           FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                            </Button>
                        </Grid>
                    </Border>
                    <Border Visibility="{Binding PreviewFlyoutVisibility}" Margin="0,0,0,12" Padding="10"
                            CornerRadius="8" Background="{DynamicResource MenuMaterial}"
                            BorderThickness="1" BorderBrush="{DynamicResource MenuStrokeMaterial}"
                            HorizontalAlignment="Left" MaxWidth="420">
                        <ContentControl Content="{Binding PreviewFlyoutContent}" Focusable="False"
                                        IsHitTestVisible="False" />
                    </Border>
                    <DockPanel Margin="0,2,0,0">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                            <TextBlock Text="{local:Loc DynamicIslandWidgetLocation}" Style="{StaticResource SettingsRowLabel}" Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding DynamicIslandPlacementChoices}"
                                      DisplayMemberPath="Label" SelectedValuePath="Value"
                                      IsEnabled="{Binding IsHardwareAvailable}"
                                      SelectedValue="{Binding DynamicIslandPlacementValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      AutomationProperties.Name="{local:Loc DynamicIslandWidgetLocation}"
                                      AutomationProperties.HelpText="{local:Loc DynamicIslandWidgetLocationDescription}" />
                        </StackPanel>
                        <ContentControl Content="{Binding SettingsView}" Focusable="False" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
