<UserControl x:Class="OpenTaskbar.Views.Widgets.WidgetCatalogItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OpenTaskbar.Services"
             FontFamily="{DynamicResource InterfaceFont}"
             Foreground="{DynamicResource TextPrimary}" Focusable="False">
    <Border x:Name="CardBorder" BorderThickness="1"
            BorderBrush="{DynamicResource StrokeSubtle}"
            Background="{DynamicResource SettingsControl}"
            CornerRadius="7" Margin="0,0,0,8">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSettingsExpanded}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource StrokeFocus}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <StackPanel>
            <Grid MinHeight="48">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="PreviewButton" Click="Preview_Click" Cursor="Hand"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource TextPrimary}"
                        HorizontalContentAlignment="Stretch"
                        AutomationProperties.Name="{Binding Label}"
                        AutomationProperties.HelpText="{Binding Description}">
                    <Grid Margin="12,0,6,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}" FontSize="13" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Grid.Column="1" Text="{Binding SettingsGlyph}" FontFamily="Segoe MDL2 Assets"
                                   FontSize="10" VerticalAlignment="Center" Margin="7,0,0,0"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </Grid>
                </Button>
                <Button x:Name="InstallButton" Grid.Column="1" Width="38" MinHeight="38" Margin="0,5,5,5"
                        Click="Install_Click" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource TextSecondary}"
                        ToolTip="{Binding InstallActionLabel}" Cursor="Hand"
                        AutomationProperties.Name="{Binding InstallActionLabel}"
                        AutomationProperties.ItemStatus="{Binding InstallStatus}">
                    <TextBlock Style="{StaticResource WidgetCatalogInstallMark}" HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Button>
            </Grid>
            <Border x:Name="SettingsDrawer" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource StrokeSubtle}"
                    Padding="16,15,16,18">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSettingsExpanded}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1"
                                                Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="150"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,12" Foreground="{DynamicResource TextPrimary}"/>
                        <Border Background="{DynamicResource SettingsBackground}" BorderBrush="{DynamicResource StrokeSubtle}"
                                BorderThickness="1" CornerRadius="6" Padding="8" MinHeight="82">
                            <ContentControl Content="{Binding NativePreview}" HorizontalAlignment="Center"
                                            VerticalAlignment="Center" Focusable="False"
                                            IsHitTestVisible="False" KeyboardNavigation.TabNavigation="None"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{local:Loc WidgetSettings}" Foreground="{DynamicResource TextPrimary}" FontSize="13" FontWeight="SemiBold"
                                   Margin="0,0,0,12"/>
                        <ContentControl Content="{Binding SettingsView}" Focusable="False"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>