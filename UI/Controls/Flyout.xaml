<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="StyleFlyoutSurface" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushGlassBase}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushSpecularBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
        <Setter Property="Padding" Value="{StaticResource PaddingCard}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Effect" Value="{StaticResource ShadowFlyout}" />
    </Style>

</ResourceDictionary>
