<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <CubicEase x:Key="EaseOut" EasingMode="EaseOut" />
    <CubicEase x:Key="EaseInOut" EasingMode="EaseInOut" />

    <DoubleAnimation x:Key="AnimFadeIn" Duration="0:0:0.15" To="1.0" EasingFunction="{StaticResource EaseOut}" />
    <DoubleAnimation x:Key="AnimFadeOut" Duration="0:0:0.12" To="0.0" EasingFunction="{StaticResource EaseInOut}" />

</ResourceDictionary>
