<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Fresnel Specular Optical Rim Light -->
    <LinearGradientBrush x:Key="BrushGlassFresnelRim" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#B5FFFFFF" Offset="0.0" />
        <GradientStop Color="#4AFFFFFF" Offset="0.08" />
        <GradientStop Color="#1EFFFFFF" Offset="0.30" />
        <GradientStop Color="#0CFFFFFF" Offset="0.75" />
        <GradientStop Color="#55000000" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Milled Glass / Acrylic Inner Bevel Refraction Line -->
    <LinearGradientBrush x:Key="BrushGlassInnerBevel" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#70FFFFFF" Offset="0.0" />
        <GradientStop Color="#25FFFFFF" Offset="0.22" />
        <GradientStop Color="#00000000" Offset="0.60" />
        <GradientStop Color="#18000000" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Cylindrical Top Glass Curvature Sheen -->
    <LinearGradientBrush x:Key="BrushGlassCylindricalSheen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#35FFFFFF" Offset="0.0" />
        <GradientStop Color="#14FFFFFF" Offset="0.38" />
        <GradientStop Color="#03FFFFFF" Offset="0.75" />
        <GradientStop Color="#00FFFFFF" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Deep Obsidian Optical Body -->
    <LinearGradientBrush x:Key="BrushGlassDeepObsidian" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#CC141A24" Offset="0.0" />
        <GradientStop Color="#D810141C" Offset="0.45" />
        <GradientStop Color="#E4080B10" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Cursor Specular Spotlight Pool -->
    <RadialGradientBrush x:Key="BrushGlassSpotlight" Center="0.5,0.0" GradientOrigin="0.5,0.0" RadiusX="0.25" RadiusY="1.0">
        <GradientStop Color="#60FFFFFF" Offset="0.0" />
        <GradientStop Color="#20FFFFFF" Offset="0.35" />
        <GradientStop Color="#08FFFFFF" Offset="0.70" />
        <GradientStop Color="#00FFFFFF" Offset="1.0" />
    </RadialGradientBrush>

    <Style x:Key="StyleGlassDockSurface" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushGlassDeepObsidian}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushGlassFresnelRim}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusDock}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="StyleGlassCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushGlassSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushTileBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

</ResourceDictionary>
