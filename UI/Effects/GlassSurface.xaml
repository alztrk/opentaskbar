<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="StyleGlassDockSurface" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushGlassBase}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushSpecularBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusDock}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="StyleGlassCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushGlassSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushTileBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

</ResourceDictionary>
