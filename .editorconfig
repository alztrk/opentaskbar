# EditorConfig is awesome: https://EditorConfig.org

root = true

# All files
[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Rust sources
[*.rs]
indent_size = 4

# Cargo manifests and other TOML configuration
[*.toml]
indent_size = 4

# PowerShell scripts
[*.ps1]
indent_size = 4

# JSON files
[*.json]
indent_size = 2

# YAML configuration files
[*.{yml,yaml}]
indent_size = 2

# Markdown documentation
[*.md]
indent_size = 2
trim_trailing_whitespace = false
