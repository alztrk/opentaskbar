<Application x:Class="OpenTaskbar.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Tokens first: StaticResources resolve at parse time. Palette is replaced by ThemeManager at runtime. -->
                <ResourceDictionary Source="Design/Tokens/Typography.xaml" />
                <ResourceDictionary Source="Design/Tokens/Spacing.xaml" />
                <ResourceDictionary Source="Design/Tokens/Radii.xaml" />
                <ResourceDictionary Source="Design/Tokens/Layout.xaml" />
                <ResourceDictionary Source="Design/Tokens/Motion.xaml" />
                <ResourceDictionary Source="Design/Palettes/Dark.xaml" />
                <!-- Icons before control styles: ContextMenus.xaml uses StaticResource IconCheck/IconChevronRight. -->
                <ResourceDictionary Source="Design/Icons/Navigation.xaml" />
                <ResourceDictionary Source="Design/Icons/Actions.xaml" />
                <ResourceDictionary Source="Design/Icons/Status.xaml" />
                <ResourceDictionary Source="Design/Icons/Media.xaml" />
                <ResourceDictionary Source="Design/Icons/Brand.xaml" />
                <ResourceDictionary Source="Design/Icons/GeometryTemplate.xaml" />
                <!-- Controls: implicit styles and cross-file BasedOn chains are ordered inside each file. -->
                <ResourceDictionary Source="Design/Controls/Tooltip.xaml" />
                <ResourceDictionary Source="Design/Controls/ScrollBar.xaml" />
                <ResourceDictionary Source="Design/DockControls.xaml" />
                <ResourceDictionary Source="Design/ContextMenus.xaml" />
                <ResourceDictionary Source="Design/Widgets.xaml" />
                <ResourceDictionary Source="Design/WidgetControls.xaml" />
                <ResourceDictionary Source="Design/SettingsControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
