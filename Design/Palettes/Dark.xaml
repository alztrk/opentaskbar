<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Neutral materials preserve application icon colors and wallpaper visibility. -->
    <!-- Slate neutrals (Tailwind-inspired): cool graphite surfaces, sky accent. -->
    <SolidColorBrush x:Key="TextPrimary" Color="#FFF3F4F6" />
    <SolidColorBrush x:Key="TextSecondary" Color="#FFAAB2C0" />
    <SolidColorBrush x:Key="TextMuted" Color="#807C8698" />
    <!-- "Aurora" accents: one teal-to-sky gradient carries every active state across the dock. -->
    <!-- Fluent Blue Windows 11 logo with refined luminance. -->
    <LinearGradientBrush x:Key="WindowsLogoBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF38BDF8" Offset="0" />
        <GradientStop Color="#FF0284C7" Offset="0.55" />
        <GradientStop Color="#FF0369A1" Offset="1" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="IconHoverGlow" GradientOrigin="0.5,0.8" Center="0.5,0.75" RadiusX="0.6" RadiusY="0.6">
        <GradientStop Color="#267DD3FC" Offset="0" />
        <GradientStop Color="#00000000" Offset="1" />
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="DockHighlight" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#40FFFFFF" Offset="0" />
        <GradientStop Color="#1AFFFFFF" Offset="0.08" />
        <GradientStop Color="#06FFFFFF" Offset="0.22" />
        <GradientStop Color="#00FFFFFF" Offset="0.45" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DockInnerBevelMaterial" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#70FFFFFF" Offset="0" />
        <GradientStop Color="#22FFFFFF" Offset="0.22" />
        <GradientStop Color="#00000000" Offset="0.6" />
        <GradientStop Color="#18000000" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="StartTileBackground" Color="#00000000" />
    <SolidColorBrush x:Key="StartTileStroke" Color="#00000000" />
    <SolidColorBrush x:Key="StartTileHover" Color="#2BFFFFFF" />
    <SolidColorBrush x:Key="StartTilePressed" Color="#3EFFFFFF" />
    <SolidColorBrush x:Key="WidgetIsland" Color="#08FFFFFF" />
    <SolidColorBrush x:Key="WidgetIslandStroke" Color="#10FFFFFF" />
    <SolidColorBrush x:Key="SurfaceKeyboardFocus" Color="#FF2A303C" />
    <LinearGradientBrush x:Key="MenuStroke" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#70FFFFFF" Offset="0" />
        <GradientStop Color="#25FFFFFF" Offset="0.35" />
        <GradientStop Color="#10FFFFFF" Offset="0.75" />
        <GradientStop Color="#4A0B1220" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MenuMaterial" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E82A303C" Offset="0" />
        <GradientStop Color="#F4252B37" Offset="0.5" />
        <GradientStop Color="#FA1F2530" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SurfacePopup" Color="#F7252B37" />
    <SolidColorBrush x:Key="StrokeSubtle" Color="#FF3A4352" />
    <SolidColorBrush x:Key="StrokeFocus" Color="#FF38BDF8" />
    <SolidColorBrush x:Key="SurfaceHover" Color="#14FFFFFF" />
    <Color x:Key="SurfaceHoverColor">#14FFFFFF</Color>
    <SolidColorBrush x:Key="SurfacePressed" Color="#22FFFFFF" />
        <!-- Shell buttons have no resting fill; their hover/press feedback must stay clearly visible on glass. -->
        <SolidColorBrush x:Key="ShellButtonHover" Color="#2AFFFFFF" />
        <SolidColorBrush x:Key="ShellButtonPressed" Color="#47FFFFFF" />
    <SolidColorBrush x:Key="SurfaceSelected" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="DockWidgetSurface" Color="#38252B34" />
    <SolidColorBrush x:Key="SurfaceSelectedStrong" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="SurfaceDanger" Color="#FFC43846" />
    <SolidColorBrush x:Key="NotificationBrush" Color="#FFFF6673" />
    <SolidColorBrush x:Key="IndicatorBrush" Color="#90E2E8F0" />
    <SolidColorBrush x:Key="IndicatorForegroundBrush" Color="#FFFFFFFF" />
    <!-- Slate glass: cool, softly translucent, breathes with the desktop. -->
    <LinearGradientBrush x:Key="DockMaterial" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#A02B313E" Offset="0" />
        <GradientStop Color="#B01B2029" Offset="1" />
    </LinearGradientBrush>
    <!-- Soft glass rim: subtle highlight on top, gentle ambient occlusion. -->
    <LinearGradientBrush x:Key="DockBorderMaterial" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#38FFFFFF" Offset="0" />
        <GradientStop Color="#18FFFFFF" Offset="0.30" />
        <GradientStop Color="#06FFFFFF" Offset="0.70" />
        <GradientStop Color="#14000000" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SettingsBackground" Color="#FF1B2029" />
    <SolidColorBrush x:Key="SettingsControl" Color="#FF252B37" />
    <SolidColorBrush x:Key="SettingsControlHover" Color="#14FFFFFF" />
    <!-- Inset track behind segmented controls and sliders. -->
    <SolidColorBrush x:Key="SettingsTrack" Color="#FF141922" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF38BDF8" />
    <SolidColorBrush x:Key="AccentText" Color="#FF05070B" />
    <!-- Darker accent stop for switch tracks; keeps the white thumb legible. -->
    <SolidColorBrush x:Key="AccentTrack" Color="#FF0369A1" />
    <SolidColorBrush x:Key="DangerText" Color="#FFFF9DA7" />
    <SolidColorBrush x:Key="MenuDivider" Color="#FF323A48" />
    <SolidColorBrush x:Key="SettingsSidebarOverlay" Color="#FF171C26" />
    <SolidColorBrush x:Key="CaptionCloseForeground" Color="#FFFFFFFF" />
    <!-- Dock widgets -->
    <SolidColorBrush x:Key="WidgetCard" Color="#00000000" />
    <SolidColorBrush x:Key="WidgetCardHover" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="WidgetCardStroke" Color="#00000000" />
    <SolidColorBrush x:Key="WidgetGlassCard" Color="#00000000" />
    <SolidColorBrush x:Key="WidgetGlassCardHover" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="WidgetGlassCardStroke" Color="#00000000" />
    <SolidColorBrush x:Key="WidgetTrack" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="WidgetAccent" Color="#FF2DD4BF" />
    <SolidColorBrush x:Key="WidgetAccentText" Color="#FFFFFFFF" />
    <LinearGradientBrush x:Key="WidgetAccentFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF2DD4BF" Offset="0" />
        <GradientStop Color="#FF0EA5E9" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WidgetFocusAccent" Color="#FFEF4444" />
    <SolidColorBrush x:Key="WidgetOnStroke" Color="#FF4F8EF7" />
    <SolidColorBrush x:Key="WidgetWarning" Color="#FFFBBF24" />
    <!-- Dock scroll edge scrims: soft directional gradient shadows for overflowing content -->
    <LinearGradientBrush x:Key="DockScrollScrimStart" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#55000000" Offset="0" />
        <GradientStop Color="#20000000" Offset="0.5" />
        <GradientStop Color="#00000000" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DockScrollScrimEnd" StartPoint="1,0" EndPoint="0,0">
        <GradientStop Color="#55000000" Offset="0" />
        <GradientStop Color="#20000000" Offset="0.5" />
        <GradientStop Color="#00000000" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DockScrollScrimTop" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#55000000" Offset="0" />
        <GradientStop Color="#20000000" Offset="0.5" />
        <GradientStop Color="#00000000" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DockScrollScrimBottom" StartPoint="0,1" EndPoint="0,0">
        <GradientStop Color="#55000000" Offset="0" />
        <GradientStop Color="#20000000" Offset="0.5" />
        <GradientStop Color="#00000000" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
