<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Neutral materials preserve application icon colors and wallpaper visibility. -->
    <!-- Slate neutrals (Tailwind-inspired): cool graphite surfaces, sky accent. -->
    <SolidColorBrush x:Key="TextPrimary" Color="#FF1B1B1B" />
    <SolidColorBrush x:Key="TextSecondary" Color="#FF61666E" />
    <SolidColorBrush x:Key="TextMuted" Color="#807C8698" />
    <!-- Fluent Blue Windows 11 logo with refined luminance. -->
    <LinearGradientBrush x:Key="WindowsLogoBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF0EA5E9" Offset="0" />
        <GradientStop Color="#FF0284C7" Offset="0.55" />
        <GradientStop Color="#FF0369A1" Offset="1" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="IconHoverGlow" GradientOrigin="0.5,0.8" Center="0.5,0.75" RadiusX="0.6" RadiusY="0.6">
        <GradientStop Color="#300284C7" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="DockHighlight" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#45FFFFFF" Offset="0" />
        <GradientStop Color="#15FFFFFF" Offset="0.5" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DockInnerBevelMaterial" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#85FFFFFF" Offset="0" />
        <GradientStop Color="#25FFFFFF" Offset="0.3" />
        <GradientStop Color="#00000000" Offset="0.65" />
        <GradientStop Color="#14000000" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="StartTileBackground" Color="#00000000" />
    <SolidColorBrush x:Key="StartTileStroke" Color="#00000000" />
    <SolidColorBrush x:Key="StartTileHover" Color="#1E000000" />
    <SolidColorBrush x:Key="StartTilePressed" Color="#30000000" />
    <SolidColorBrush x:Key="WidgetIsland" Color="#0A000000" />
    <SolidColorBrush x:Key="WidgetIslandStroke" Color="#12000000" />
    <SolidColorBrush x:Key="SurfaceKeyboardFocus" Color="#FFE9E9E9" />
    <LinearGradientBrush x:Key="MenuStroke" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#85FFFFFF" Offset="0" />
        <GradientStop Color="#30000000" Offset="0.35" />
        <GradientStop Color="#20000000" Offset="0.75" />
        <GradientStop Color="#400F172A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MenuMaterial" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F0FFFFFF" Offset="0" />
        <GradientStop Color="#F8FFFFFF" Offset="0.5" />
        <GradientStop Color="#FCF7F7F7" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SurfacePopup" Color="#F7FFFFFF" />
    <SolidColorBrush x:Key="StrokeSubtle" Color="#FFE5E5E5" />
    <SolidColorBrush x:Key="StrokeFocus" Color="#FF0369A1" />
    <SolidColorBrush x:Key="SurfaceHover" Color="#0D000000" />
    <Color x:Key="SurfaceHoverColor">#0D000000</Color>
    <SolidColorBrush x:Key="SurfacePressed" Color="#16000000" />
        <!-- Shell buttons have no resting fill; their hover/press feedback must stay clearly visible on glass. -->
        <SolidColorBrush x:Key="ShellButtonHover" Color="#1A000000" />
        <SolidColorBrush x:Key="ShellButtonPressed" Color="#30000000" />
    <SolidColorBrush x:Key="SurfaceSelected" Color="#0D000000" />
    <SolidColorBrush x:Key="DockWidgetSurface" Color="#AFFFFFFF" />
    <SolidColorBrush x:Key="SurfaceSelectedStrong" Color="#16000000" />
    <SolidColorBrush x:Key="SurfaceDanger" Color="#FFC43846" />
    <SolidColorBrush x:Key="NotificationBrush" Color="#FFD22D42" />
    <SolidColorBrush x:Key="IndicatorBrush" Color="#601E293B" />
    <SolidColorBrush x:Key="IndicatorForegroundBrush" Color="#E00F172A" />
    <!-- Slate glass: cool, softly translucent. -->
    <LinearGradientBrush x:Key="DockMaterial" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#B8FFFFFF" Offset="0" />
        <GradientStop Color="#C8F3F3F3" Offset="1" />
    </LinearGradientBrush>
    <!-- Soft glass rim for light glass. -->
    <LinearGradientBrush x:Key="DockBorderMaterial" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#60FFFFFF" Offset="0" />
        <GradientStop Color="#25FFFFFF" Offset="0.3" />
        <GradientStop Color="#15000000" Offset="0.7" />
        <GradientStop Color="#25000000" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SettingsBackground" Color="#FFF3F3F3" />
    <SolidColorBrush x:Key="SettingsControl" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SettingsControlHover" Color="#0D000000" />
    <!-- Inset track behind segmented controls and sliders. -->
    <SolidColorBrush x:Key="SettingsTrack" Color="#FFE9E9E9" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF0369A1" />
    <SolidColorBrush x:Key="AccentText" Color="#FFFFFFFF" />
    <!-- Darker accent stop for switch tracks; keeps the white thumb legible. -->
    <SolidColorBrush x:Key="AccentTrack" Color="#FF075985" />
    <SolidColorBrush x:Key="DangerText" Color="#FFAF2338" />
    <SolidColorBrush x:Key="MenuDivider" Color="#FFE8E8E8" />
    <SolidColorBrush x:Key="SettingsSidebarOverlay" Color="#FFEEEEEE" />
    <SolidColorBrush x:Key="CaptionCloseForeground" Color="#FFFFFFFF" />
    <!-- Dock widgets -->
    <SolidColorBrush x:Key="WidgetCard" Color="#00000000" />
    <SolidColorBrush x:Key="WidgetCardHover" Color="#12000000" />
    <SolidColorBrush x:Key="WidgetCardStroke" Color="#00000000" />
    <SolidColorBrush x:Key="WidgetGlassCard" Color="#00000000" />
    <SolidColorBrush x:Key="WidgetGlassCardHover" Color="#12000000" />
    <SolidColorBrush x:Key="WidgetGlassCardStroke" Color="#00000000" />
    <SolidColorBrush x:Key="WidgetTrack" Color="#1F000000" />
    <SolidColorBrush x:Key="WidgetAccent" Color="#FF0D9488" />
    <SolidColorBrush x:Key="WidgetAccentText" Color="#FFFFFFFF" />
    <LinearGradientBrush x:Key="WidgetAccentFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF14B8A6" Offset="0" />
        <GradientStop Color="#FF0284C7" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WidgetFocusAccent" Color="#FFDC2626" />
    <SolidColorBrush x:Key="WidgetOnStroke" Color="#FF2563EB" />
    <SolidColorBrush x:Key="WidgetWarning" Color="#FFD97706" />
    <!-- Dock scroll edge scrims: soft directional gradient shadows for overflowing content -->
    <LinearGradientBrush x:Key="DockScrollScrimStart" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#60FFFFFF" Offset="0" />
        <GradientStop Color="#20FFFFFF" Offset="0.5" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DockScrollScrimEnd" StartPoint="1,0" EndPoint="0,0">
        <GradientStop Color="#60FFFFFF" Offset="0" />
        <GradientStop Color="#20FFFFFF" Offset="0.5" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DockScrollScrimTop" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#60FFFFFF" Offset="0" />
        <GradientStop Color="#20FFFFFF" Offset="0.5" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DockScrollScrimBottom" StartPoint="0,1" EndPoint="0,0">
        <GradientStop Color="#60FFFFFF" Offset="0" />
        <GradientStop Color="#20FFFFFF" Offset="0.5" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
