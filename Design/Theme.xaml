<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:svc="clr-namespace:OpenTaskbar.Services">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Palettes/Dark.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <FontFamily x:Key="InterfaceFont">Segoe UI</FontFamily>
    <sys:Double x:Key="MenuLabelWidth">286</sys:Double>
    <Thickness x:Key="MenuRowPadding">10,7</Thickness>
    <Thickness x:Key="MenuDividerInset">12,7</Thickness>
    <sys:Double x:Key="TextSizeBody">13</sys:Double>
    <sys:Double x:Key="TextSizeCaption">12</sys:Double>
    <sys:Double x:Key="TextSizeWidgetLabel">11</sys:Double>
    <sys:Double x:Key="DockResizeGripWidth">8</sys:Double>
    <Thickness x:Key="DockWidgetPadding">9,5</Thickness>
    <Thickness x:Key="DockWidgetActionPadding">6,0</Thickness>
    <Thickness x:Key="DockWidgetActionMargin">6,0,0,0</Thickness>
    <CornerRadius x:Key="DockWidgetActionRadius">5</CornerRadius>
    <!-- Dock geometry lives in Services/DockMetrics.cs; these keys expose it to XAML. -->
    <x:Static x:Key="DockHeadroom" Member="svc:DockMetrics.Headroom" />
    <sys:Double x:Key="DockWindowHeight">98</sys:Double>
    <sys:Double x:Key="DockMinimumShelfHeight">74</sys:Double>
    <x:Static x:Key="DockCellSize" Member="svc:DockMetrics.CellSize" />
    <x:Static x:Key="DockCellHeight" Member="svc:DockMetrics.CellSize" />
    <x:Static x:Key="DockIconSize" Member="svc:DockMetrics.IconSize" />
    <sys:Double x:Key="DockApplicationIconSize">34</sys:Double>
    <sys:Double x:Key="StartLogoSize">20</sys:Double>
    <x:Static x:Key="DockEdgeTriggerHeight" Member="svc:DockMetrics.EdgeTriggerHeight" />
    <sys:Double x:Key="TextSizeWidgetValue">18</sys:Double>
    <sys:Double x:Key="DockWidgetMinimumWidth">104</sys:Double>
    <sys:Double x:Key="DockWidgetMinimumHeight">52</sys:Double>
    <sys:Double x:Key="DockWidgetValueMaxWidth">180</sys:Double>
    <sys:Double x:Key="PreviewWidth">228</sys:Double>
    <sys:Double x:Key="PreviewHeight">154</sys:Double>
    <sys:Double x:Key="PreviewHeaderHeight">32</sys:Double>
    <x:Static x:Key="PreviewGap" Member="svc:DockMetrics.PreviewGap" />
    <x:Static x:Key="DockHoverScale" Member="svc:DockMetrics.HoverScale" />
    <sys:Double x:Key="PreviewDurationMs">160</sys:Double>
    <x:Static x:Key="DockInset" Member="svc:DockMetrics.Inset" />
    <Thickness x:Key="DockScrollContentInset">6,0</Thickness>
    <x:Static x:Key="DockPadding" Member="svc:DockMetrics.Padding" />
    <Thickness x:Key="ControlStroke">1</Thickness>
    <CornerRadius x:Key="DockRadius">18</CornerRadius>
    <CornerRadius x:Key="DockInnerRadius">17</CornerRadius>
    <CornerRadius x:Key="DockSheenRadius">17,17,0,0</CornerRadius>
    <CornerRadius x:Key="ControlRadius">12</CornerRadius>
    <CornerRadius x:Key="DockWidgetRadius">12</CornerRadius>
    <CornerRadius x:Key="PopupRadius">12</CornerRadius>
    <CornerRadius x:Key="PopupInnerRadius">11</CornerRadius>
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource SurfacePopup}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource InterfaceFont}" />
        <Setter Property="FontSize" Value="{DynamicResource TextSizeCaption}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Placement" Value="Custom" />
        <Setter Property="CustomPopupPlacementCallback" Value="{x:Static svc:DockMetrics.TooltipPlacementCallback}" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource PopupRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical"
                           Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                           Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                        <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" /></Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Margin="0,1" MinHeight="20">
                                <Thumb.Style>
                                    <Style TargetType="Thumb">
                                        <Setter Property="Background" Value="{DynamicResource MenuDivider}" />
                                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" CornerRadius="2" /></ControlTemplate></Setter.Value></Setter>
                                        <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource TextSecondary}" /></Trigger></Style.Triggers>
                                    </Style>
                                </Thumb.Style>
                            </Thumb>
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" /></Track.IncreaseRepeatButton>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

