<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Inter is embedded in Fonts/ so every machine renders the UI identically. MDL2 stays the icon font. -->
    <FontFamily x:Key="InterfaceFont">pack://application:,,,/Fonts/#Inter</FontFamily>
    <sys:Double x:Key="TextSizeBody">13</sys:Double>
    <sys:Double x:Key="TextSizeCaption">12</sys:Double>
    <sys:Double x:Key="TextSizeWidgetValue">18</sys:Double>
    <FontFamily x:Key="WidgetActionFont">Segoe MDL2 Assets</FontFamily>
</ResourceDictionary>
