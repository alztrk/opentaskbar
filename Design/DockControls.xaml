<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:OpenTaskbar.Views"
                    xmlns:local="clr-namespace:OpenTaskbar.Services">
    <Style x:Key="DockResizeThumb" TargetType="Thumb">
        <Setter Property="Width" Value="{StaticResource DockResizeGripWidth}" />
        <Setter Property="Cursor" Value="SizeWE" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent" Width="{TemplateBinding Width}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Border x:Name="GripIndicator" Width="3" Height="14" CornerRadius="1.5"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="{DynamicResource IndicatorBrush}" Opacity="0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="GripIndicator" Property="Opacity" Value="0.65" />
                            <Setter TargetName="GripIndicator" Property="Height" Value="20" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="GripIndicator" Property="Opacity" Value="1.0" />
                            <Setter TargetName="GripIndicator" Property="Height" Value="28" />
                            <Setter TargetName="GripIndicator" Property="Width" Value="4" />
                            <Setter TargetName="GripIndicator" Property="Background" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="DockButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="{DynamicResource DockCellSize}" />
        <Setter Property="Height" Value="{DynamicResource DockCellHeight}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}"
                            BorderBrush="Transparent" BorderThickness="0"
                            CornerRadius="{StaticResource ControlRadius}" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="6" />
                            </Grid.RowDefinitions>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <!-- Calm macOS-style active running indicator dot -->
                            <Rectangle x:Name="ActiveIndicator" Grid.Row="1" Height="4" Width="4" RadiusX="2" RadiusY="2"
                                       Fill="{DynamicResource IndicatorBrush}" VerticalAlignment="Center"
                                       HorizontalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.48" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ActiveIndicator" Property="Opacity" Value="0.75" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsForeground}" Value="True">
                            <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ActiveIndicator" Property="Opacity" Value="1.0" />
                            <Setter TargetName="ActiveIndicator" Property="Width" Value="5" />
                            <Setter TargetName="ActiveIndicator" Property="Height" Value="5" />
                            <Setter TargetName="ActiveIndicator" Property="RadiusX" Value="2.5" />
                            <Setter TargetName="ActiveIndicator" Property="RadiusY" Value="2.5" />
                            <Setter TargetName="ActiveIndicator" Property="Fill" Value="{DynamicResource IndicatorForegroundBrush}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Clean Start button template with zero artificial card boxes -->
    <Style x:Key="StartDockButton" TargetType="Button" BasedOn="{StaticResource DockButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DockScrollIndicatorButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="Panel.ZIndex" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderThickness="0"
                            CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                            Padding="{TemplateBinding Padding}">
                        <Path x:Name="IndicatorGlyph"
                              Data="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                              Stroke="{DynamicResource TextPrimary}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              MaxWidth="12" MaxHeight="14"
                              Stretch="Uniform"
                              Opacity="0.85"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <Path.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.55" />
                            </Path.Effect>
                        </Path>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="IndicatorGlyph" Property="Opacity" Value="1.0" />
                            <Setter TargetName="IndicatorGlyph" Property="Stroke" Value="{DynamicResource IndicatorForegroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="IndicatorGlyph" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DockScrollViewerStyle" TargetType="{x:Type views:DockScrollViewer}">
        <Setter Property="AutomationProperties.HelpText" Value="{local:Loc ScrollDockHelp}" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
        <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="CanContentScroll" Value="False" />
        <Setter Property="PanningMode" Value="HorizontalOnly" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type views:DockScrollViewer}">
                    <Grid ClipToBounds="True">
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" CanContentScroll="False">
                            <ScrollContentPresenter.Content>
                                <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Margin="{TemplateBinding Padding}" />
                            </ScrollContentPresenter.Content>
                        </ScrollContentPresenter>
                        <Button x:Name="PART_PreviousButton" Style="{StaticResource DockScrollIndicatorButton}"
                                Background="{DynamicResource DockScrollScrimStart}"
                                HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="28"
                                Margin="{TemplateBinding Padding}"
                                HorizontalContentAlignment="Left" Padding="5,0,0,0"
                                Tag="16,0,0,16"
                                AutomationProperties.Name="{local:Loc ScrollDockHelp}" ToolTip="{local:Loc ScrollDockHelp}" />
                        <Button x:Name="PART_NextButton" Style="{StaticResource DockScrollIndicatorButton}"
                                Background="{DynamicResource DockScrollScrimEnd}"
                                HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="28"
                                Margin="{TemplateBinding Padding}"
                                HorizontalContentAlignment="Right" Padding="0,0,5,0"
                                Tag="0,16,16,0"
                                AutomationProperties.Name="{local:Loc ScrollDockHelp}" ToolTip="{local:Loc ScrollDockHelp}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
