<w:DockWidget x:Class="OpenTaskbar.Widgets.MediaWidget"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:w="clr-namespace:OpenTaskbar.Widgets"
              xmlns:local="clr-namespace:OpenTaskbar.Services">
    <Border x:Name="Card" Style="{StaticResource WidgetCardBorder}" Padding="9,0,9,0">
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 1. Thumbnail with artwork-derived subtle color tint -->
            <Border x:Name="ArtFrame" Grid.Column="0" Width="29" Height="29" CornerRadius="7" ClipToBounds="True" VerticalAlignment="Center">
                <Border.Background>
                    <SolidColorBrush x:Name="ArtTintBrush" Color="#FF526D84" />
                </Border.Background>
                <Grid>
                    <ContentControl x:Name="ArtPlaceholder" Style="{StaticResource WidgetIcon}" Content="{StaticResource IconMusic}"
                                    Width="15" Height="15" Foreground="#FFEFEFEF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image x:Name="ArtImage" Width="29" Height="29" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Clip>
                            <RectangleGeometry Rect="0,0,29,29" RadiusX="7" RadiusY="7" />
                        </Image.Clip>
                    </Image>
                </Grid>
            </Border>

            <!-- 2. Song information -->
            <StackPanel x:Name="InfoPanel" Grid.Column="1" Width="96" Margin="9,0,10,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Style="{StaticResource WidgetText}" FontSize="12" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ArtistText" Style="{StaticResource WidgetCaption}" FontSize="10.5"
                           TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
            </StackPanel>

            <!-- 3. Progress bar with elapsed and total time -->
            <Grid x:Name="ProgressPanel" Grid.Column="2" MinWidth="138" Margin="0,0,8,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ElapsedText" Grid.Column="0" Style="{StaticResource WidgetCaption}" FontSize="9.5"
                           Text="0:00" Margin="0,0,6,0" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                <Slider x:Name="ProgressSlider" Grid.Column="1" Style="{StaticResource MediaProgressSlider}" Minimum="0" Maximum="100" Value="0"
                        VerticalAlignment="Center"
                        PreviewMouseLeftButtonDown="ProgressSlider_PreviewMouseLeftButtonDown"
                        PreviewMouseLeftButtonUp="ProgressSlider_PreviewMouseLeftButtonUp"
                        LostMouseCapture="ProgressSlider_LostMouseCapture"
                        ValueChanged="ProgressSlider_ValueChanged" />
                <TextBlock x:Name="TotalText" Grid.Column="2" Style="{StaticResource WidgetCaption}" FontSize="9.5"
                           Text="0:00" Margin="6,0,0,0" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
            </Grid>

            <!-- 4. Playback controls: Previous, Play/Pause, Next -->
            <StackPanel x:Name="TransportPanel" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                <Button x:Name="PreviousButton" Style="{StaticResource WidgetIconButton}" Width="25" Height="27" Click="Previous_Click"
                        ToolTip="{local:Loc MediaPrevious}" AutomationProperties.Name="{local:Loc MediaPrevious}">
                    <ContentControl Style="{StaticResource WidgetGlyph}" Content="{StaticResource IconPreviousFill}" Width="11" Height="11" />
                </Button>
                <Button x:Name="PlayPauseButton" Style="{StaticResource WidgetIconButton}" Width="27" Height="27" Margin="2,0"
                        Background="{DynamicResource SurfaceSelected}" Click="PlayPause_Click"
                        ToolTip="{local:Loc MediaPlayPause}" AutomationProperties.Name="{local:Loc MediaPlayPause}">
                    <ContentControl x:Name="PlayPauseGlyph" Style="{StaticResource WidgetGlyph}" Content="{StaticResource IconPlayFill}" Width="13" Height="13" />
                </Button>
                <Button x:Name="NextButton" Style="{StaticResource WidgetIconButton}" Width="25" Height="27" Click="Next_Click"
                        ToolTip="{local:Loc MediaNext}" AutomationProperties.Name="{local:Loc MediaNext}">
                    <ContentControl Style="{StaticResource WidgetGlyph}" Content="{StaticResource IconNextFill}" Width="11" Height="11" />
                </Button>
            </StackPanel>

            <!-- 5. Volume icon on far right (hover opens compact volume popover above) -->
            <Grid x:Name="VolumePanel" Grid.Column="4" VerticalAlignment="Center" Background="Transparent"
                  MouseWheel="Volume_MouseWheel" MouseEnter="VolumeTrigger_MouseEnter" MouseLeave="VolumeTrigger_MouseLeave">
                <Button x:Name="MuteButton" Style="{StaticResource WidgetIconButton}" Width="27" Height="27"
                        Background="{DynamicResource SurfaceSelected}" Click="MuteButton_Click"
                        ToolTip="{local:Loc Volume}" AutomationProperties.Name="{local:Loc MuteToggle}">
                    <ContentControl x:Name="VolumeIcon" Style="{StaticResource WidgetIcon}" Content="{StaticResource IconVolume}" Width="14" Height="14" />
                </Button>
                <Popup x:Name="VolumePopup" PlacementTarget="{Binding ElementName=VolumePanel}" Placement="Custom"
                       AllowsTransparency="True" StaysOpen="True" PopupAnimation="Fade">
                    <Border x:Name="VolumePopoverSurface" Width="62" Padding="8,11,8,11" CornerRadius="12" BorderThickness="1"
                            Background="{DynamicResource MenuMaterial}" BorderBrush="{DynamicResource MenuStrokeMaterial}"
                            MouseEnter="VolumePopover_MouseEnter" MouseLeave="VolumePopover_MouseLeave" MouseWheel="Volume_MouseWheel">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="VolumePopoverScale" ScaleX="1" ScaleY="1" />
                                <TranslateTransform x:Name="VolumePopoverTranslate" Y="0" />
                            </TransformGroup>
                        </Border.RenderTransform>
                        <Border.RenderTransformOrigin>0.5,1</Border.RenderTransformOrigin>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="VolumePercentText" Text="67%" FontSize="11.5" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,0,0,8"
                                       Foreground="{DynamicResource TextPrimary}" Typography.NumeralAlignment="Tabular" />
                            <Slider x:Name="VolumeSlider" Style="{StaticResource WidgetVerticalSlider}" Height="104"
                                    HorizontalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged"
                                    AutomationProperties.Name="{local:Loc Volume}" />
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Grid>
    </Border>
</w:DockWidget>
