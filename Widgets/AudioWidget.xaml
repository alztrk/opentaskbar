<w:DockWidget x:Class="OpenTaskbar.Widgets.AudioWidget"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:w="clr-namespace:OpenTaskbar.Widgets"
              xmlns:local="clr-namespace:OpenTaskbar.Services">
    <Button x:Name="Card" Style="{StaticResource WidgetCardButton}"
            Width="{StaticResource WidgetHeight}" Padding="0"
            Click="Card_Click" MouseWheel="Card_MouseWheel" MouseDown="Card_MouseDown"
            AutomationProperties.Name="{local:Loc Volume}">
        <ContentControl x:Name="VolumeIcon" Style="{StaticResource WidgetIcon}"
                        Content="{StaticResource IconVolume}" Width="16" Height="16"
                        HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Button>
</w:DockWidget>
