<w:DockWidget x:Class="OpenTaskbar.Widgets.AudioWidget"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:w="clr-namespace:OpenTaskbar.Widgets"
              xmlns:local="clr-namespace:OpenTaskbar.Services"
              PreviewMouseWheel="AudioWidget_PreviewMouseWheel">
    <Grid>
        <Button x:Name="ComboButton" Style="{StaticResource WidgetCardButton}" Padding="10,0"
                Click="ComboButton_Click"
                AutomationProperties.Name="{local:Loc WidgetAudio}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ContentControl x:Name="OutputIcon" Style="{StaticResource WidgetIcon}" Content="{StaticResource IconVolume}"
                                Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,7,0"
                                Foreground="{DynamicResource TextPrimary}" />
                <TextBlock x:Name="VolumeText" Style="{StaticResource WidgetText}" Text="—"
                           FontSize="12.5" FontWeight="SemiBold" MinWidth="38" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimary}" Typography.NumeralAlignment="Tabular" />
            </StackPanel>
        </Button>
        <Border x:Name="IslandPanel" Style="{StaticResource WidgetCardBorder}" Visibility="Collapsed" Padding="6,0">
            <Slider x:Name="IslandOutputSlider" Width="88" Minimum="0" Maximum="100"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Style="{StaticResource WidgetSlider}" ValueChanged="IslandOutputSlider_ValueChanged"
                    AutomationProperties.Name="{local:Loc AudioOutput}" />
        </Border>
    </Grid>
</w:DockWidget>
