<w:DockWidget x:Class="OpenTaskbar.Widgets.FocusWidget"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:w="clr-namespace:OpenTaskbar.Widgets"
              xmlns:local="clr-namespace:OpenTaskbar.Services">
    <Border x:Name="Card" Style="{StaticResource WidgetCardBorder}" Padding="10,0,8,0"
            MouseLeftButtonUp="Card_MouseLeftButtonUp" Cursor="Hand">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="{local:Loc FocusReset}" Icon="{StaticResource IconReset}" Click="Reset_Click" />
            </ContextMenu>
        </Border.ContextMenu>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <ContentControl x:Name="FocusIcon" Style="{StaticResource WidgetIcon}" Content="{StaticResource IconTarget}"
                            Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center"
                            Foreground="{DynamicResource TextSecondary}" />
            <TextBlock x:Name="RemainingText" Style="{StaticResource WidgetText}" FontSize="13" FontWeight="SemiBold"
                       VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
            <Button x:Name="PlayButton" Style="{StaticResource WidgetIconButton}" Width="26" Height="26" Margin="8,0,0,0"
                    Click="Toggle_Click">
                <ContentControl x:Name="ToggleGlyph" Style="{StaticResource WidgetGlyph}" Content="{StaticResource IconPlayFill}"
                                Width="12" Height="12" />
            </Button>
        </StackPanel>
    </Border>
</w:DockWidget>
