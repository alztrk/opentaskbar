<w:DockWidget x:Class="OpenTaskbar.Widgets.QuickSettingsWidget"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:w="clr-namespace:OpenTaskbar.Widgets"
              xmlns:local="clr-namespace:OpenTaskbar.Services">
    <Border Style="{StaticResource WidgetCardBorder}" Padding="8,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border x:Name="WifiPill" CornerRadius="7" BorderThickness="1" Background="Transparent" BorderBrush="Transparent" Margin="0,0,4,0">
                <ToggleButton x:Name="WifiToggle" Style="{StaticResource WidgetIconButton}" Width="27" Height="27" Click="WifiToggle_Click">
                    <ContentControl Style="{StaticResource WidgetIcon}" Content="{StaticResource IconWifi}" Width="15" Height="15" />
                </ToggleButton>
            </Border>
            <Border x:Name="BluetoothPill" CornerRadius="7" BorderThickness="1" Background="Transparent" BorderBrush="Transparent" Margin="0,0,4,0">
                <ToggleButton x:Name="BluetoothToggle" Style="{StaticResource WidgetIconButton}" Width="27" Height="27" Click="BluetoothToggle_Click">
                    <ContentControl Style="{StaticResource WidgetIcon}" Content="{StaticResource IconBluetooth}" Width="15" Height="15" />
                </ToggleButton>
            </Border>
            <Border x:Name="NightLightPill" CornerRadius="7" BorderThickness="1" Background="Transparent" BorderBrush="Transparent">
                <ToggleButton x:Name="NightLightToggle" Style="{StaticResource WidgetIconButton}" Width="27" Height="27" Click="NightLightToggle_Click"
                              ToolTip="{local:Loc NightLight}" AutomationProperties.Name="{local:Loc NightLight}">
                    <ContentControl Style="{StaticResource WidgetIcon}" Content="{StaticResource IconMoon}" Width="15" Height="15" />
                </ToggleButton>
            </Border>
        </StackPanel>
    </Border>
</w:DockWidget>
