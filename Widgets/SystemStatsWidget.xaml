<w:DockWidget x:Class="OpenTaskbar.Widgets.SystemStatsWidget"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:w="clr-namespace:OpenTaskbar.Widgets"
              xmlns:local="clr-namespace:OpenTaskbar.Services">
    <Button x:Name="StatsCardButton" Style="{StaticResource WidgetCardButton}" Padding="10,0"
            Click="StatsCardButton_Click" AutomationProperties.Name="{local:Loc WidgetSystemStats}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <ContentControl Style="{StaticResource WidgetIcon}" Content="{StaticResource IconCpu}"
                            Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"
                            Foreground="{DynamicResource TextSecondary}" />

            <!-- CPU metric -->
            <StackPanel x:Name="CpuButton" VerticalAlignment="Center" Orientation="Vertical">
                <TextBlock x:Name="CpuLabel" Text="CPU" FontSize="10" LineHeight="11"
                           Foreground="{DynamicResource TextSecondary}" />
                <TextBlock x:Name="CpuValueText" Text="—" FontSize="12.5" FontWeight="SemiBold" LineHeight="14"
                           Foreground="{DynamicResource TextPrimary}" Typography.NumeralAlignment="Tabular" />
            </StackPanel>

            <!-- RAM metric -->
            <Border x:Name="RamDivider" Width="1" Height="18" Background="{DynamicResource StrokeSubtle}"
                    Margin="9,0" VerticalAlignment="Center" />
            <StackPanel x:Name="MemoryButton" VerticalAlignment="Center" Orientation="Vertical">
                <TextBlock x:Name="RamLabel" Text="RAM" FontSize="10" LineHeight="11"
                           Foreground="{DynamicResource TextSecondary}" />
                <TextBlock x:Name="RamValueText" Text="—" FontSize="12.5" FontWeight="SemiBold" LineHeight="14"
                           Foreground="{DynamicResource TextPrimary}" Typography.NumeralAlignment="Tabular" />
            </StackPanel>

            <!-- GPU metric (shown once validated) -->
            <Border x:Name="GpuDivider" Width="1" Height="18" Background="{DynamicResource StrokeSubtle}"
                    Margin="9,0" VerticalAlignment="Center" Visibility="Collapsed" />
            <StackPanel x:Name="GpuButton" VerticalAlignment="Center" Orientation="Vertical" Visibility="Collapsed">
                <TextBlock x:Name="GpuLabel" Text="GPU" FontSize="10" LineHeight="11"
                           Foreground="{DynamicResource TextSecondary}" />
                <TextBlock x:Name="GpuValueText" Text="—" FontSize="12.5" FontWeight="SemiBold" LineHeight="14"
                           Foreground="{DynamicResource TextPrimary}" Typography.NumeralAlignment="Tabular" />
            </StackPanel>

            <!-- Optional temperatures (validated sensor slots; kept for Settings.StatsMeters and tests) -->
            <Border x:Name="CpuTempDivider" Width="1" Height="18" Background="{DynamicResource StrokeSubtle}"
                    Margin="9,0" VerticalAlignment="Center" Visibility="Collapsed" />
            <StackPanel x:Name="CpuTemperatureButton" VerticalAlignment="Center" Orientation="Vertical" Visibility="Collapsed">
                <TextBlock Text="CPU°" FontSize="10" LineHeight="11" Foreground="{DynamicResource TextSecondary}" />
                <TextBlock x:Name="CpuTempValueText" Text="—" FontSize="12.5" FontWeight="SemiBold" LineHeight="14"
                           Foreground="{DynamicResource TextPrimary}" Typography.NumeralAlignment="Tabular" />
            </StackPanel>

            <Border x:Name="GpuTempDivider" Width="1" Height="18" Background="{DynamicResource StrokeSubtle}"
                    Margin="9,0" VerticalAlignment="Center" Visibility="Collapsed" />
            <StackPanel x:Name="GpuTemperatureButton" VerticalAlignment="Center" Orientation="Vertical" Visibility="Collapsed">
                <TextBlock Text="GPU°" FontSize="10" LineHeight="11" Foreground="{DynamicResource TextSecondary}" />
                <TextBlock x:Name="GpuTempValueText" Text="—" FontSize="12.5" FontWeight="SemiBold" LineHeight="14"
                           Foreground="{DynamicResource TextPrimary}" Typography.NumeralAlignment="Tabular" />
            </StackPanel>
        </StackPanel>
    </Button>
</w:DockWidget>
